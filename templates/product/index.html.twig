
{% extends 'base.html.twig' %}

{% block title %}Manage Products | NS COSMETIQ{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .ns-products {
            padding: 25px 5px 50px;
            color: #49332D;
        }

        .ns-products-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 16px;
            margin-bottom: 28px;
        }

        .ns-products-header h1 {
            font-size: 29px;
            font-weight: 800;
            margin-bottom: 5px;
            color: #49332D;
        }

        .ns-products-header p {
            color: #8C7168;
            margin: 0;
            font-size: 14px;
        }

        .ns-add-btn {
            background: #C0603F;
            color: white;
            padding: 12px 22px;
            border-radius: 12px;
            text-decoration: none;
            font-weight: 700;
            border: none;
            transition: 0.2s;
        }

        .ns-add-btn:hover {
            background: #A94E32;
            color: white;
            transform: translateY(-2px);
        }

        .ns-filter-card {
            background: white;
            padding: 22px;
            border: 1px solid #F0E1DB;
            border-radius: 18px;
            margin-bottom: 25px;
        }

        .ns-filter-card .form-control {
            border: 1px solid #E6D4CC;
            border-radius: 10px;
            min-height: 45px;
        }

        .ns-filter-card .form-control:focus {
            border-color: #C0603F;
            box-shadow: 0 0 0 3px rgba(192, 96, 63, 0.12);
        }

        .ns-search-btn {
            background: #49332D;
            color: white;
            border: none;
            border-radius: 10px;
            padding: 11px 18px;
            font-weight: 600;
        }

        .ns-search-btn:hover {
            background: #67483E;
            color: white;
        }

        .ns-reset-btn {
            background: #F3E7E2;
            color: #49332D;
            border: none;
            border-radius: 10px;
            padding: 11px 18px;
            text-decoration: none;
            font-weight: 600;
        }

        .ns-reset-btn:hover {
            background: #E9D7CE;
            color: #49332D;
        }

        .ns-table-card {
            background: white;
            border: 1px solid #F0E1DB;
            border-radius: 18px;
            overflow: hidden;
        }

        .ns-table {
            width: 100%;
            margin-bottom: 0;
            border-collapse: collapse;
        }

        .ns-table thead {
            background: #F6E9E3;
        }

        .ns-table th {
            padding: 18px 15px;
            color: #49332D;
            font-size: 13px;
            font-weight: 800;
            white-space: nowrap;
            border-bottom: 1px solid #EBD9D1;
        }

        .ns-table td {
            padding: 15px;
            vertical-align: middle;
            border-bottom: 1px solid #F3EAE6;
            font-size: 14px;
        }

        .ns-table tbody tr:hover {
            background: #FFFAF8;
        }

        .ns-table tbody tr:last-child td {
            border-bottom: none;
        }

        .ns-product-img {
            width: 76px;
            height: 76px;
            object-fit: cover;
            border-radius: 12px;
            border: 1px solid #F0E1DB;
            background: #FFF8F5;
        }

        .ns-no-image {
            width: 76px;
            height: 76px;
            border-radius: 12px;
            background: #F9E3DC;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            color: #A47D70;
            font-size: 10px;
            gap: 4px;
            text-align: center;
        }

        .ns-product-name {
            font-weight: 700;
            color: #49332D;
        }

        .ns-category {
            display: inline-block;
            padding: 6px 12px;
            border-radius: 20px;
            background: #FFF0EA;
            color: #A9573C;
            font-size: 12px;
            font-weight: 700;
        }

        .ns-price {
            color: #A9573C;
            font-weight: 800;
            white-space: nowrap;
        }

        .ns-stock {
            font-weight: 700;
        }

        .ns-stock-low {
            color: #B04752;
        }

        .ns-stock-ok {
            color: #3E8067;
        }

        .ns-edit-btn {
            background: #EBC5B5;
            color: #49332D;
            border-radius: 9px;
            padding: 9px 15px;
            font-size: 12px;
            font-weight: 700;
            text-decoration: none;
            display: inline-block;
            border: none;
        }

        .ns-edit-btn:hover {
            background: #DDAF9B;
            color: #49332D;
        }

        .ns-delete-btn {
            background: #AF4652;
            color: white;
            border-radius: 9px;
            padding: 9px 15px;
            font-size: 12px;
            font-weight: 700;
            border: none;
        }

        .ns-delete-btn:hover {
            background: #96333E;
        }

        .ns-action-group {
            display: flex;
            gap: 7px;
            align-items: center;
        }

        .ns-empty {
            text-align: center;
            padding: 50px 20px !important;
            color: #9A8177;
        }

        @media (max-width: 768px) {
            .ns-products-header h1 {
                font-size: 24px;
            }

            .ns-table th,
            .ns-table td {
                padding: 12px;
            }
        }
    </style>
{% endblock %}

{% block body %}
<div class="container-fluid ns-products">

    <div class="ns-products-header">
        <div>
            <h1>Manage Products</h1>
            <p>Organize your beauty collection, inventory, and product images.</p>
        </div>

        <a href="{{ path('product_new') }}" class="ns-add-btn">
            + Add New Product
        </a>
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success rounded-3">
            {{ message }}
        </div>
    {% endfor %}

    {% for message in app.flashes('danger') %}
    <div class="alert alert-danger rounded-3" role="alert">
        {{ message }}
    </div>
{% endfor %}

    <div class="ns-filter-card">
        <form method="get" action="{{ path('product_index') }}" class="row g-3 align-items-end">

            <div class="col-lg-5">
                <label class="form-label fw-semibold">Search Products</label>
                <input
                    type="text"
                    name="search"
                    class="form-control"
                    placeholder="Search by product name..."
                    value="{{ search }}"
                >
            </div>

            <div class="col-lg-4">
                <label class="form-label fw-semibold">Category</label>
                <input
                    type="text"
                    name="category"
                    class="form-control"
                    placeholder="e.g. Makeup, Skincare"
                    value="{{ category }}"
                >
            </div>

            <div class="col-lg-3">
                <div class="d-flex gap-2">
                    <button type="submit" class="ns-search-btn">
                        Search
                    </button>

                    <a href="{{ path('product_index') }}" class="ns-reset-btn">
                        Reset
                    </a>
                </div>
            </div>

        </form>
    </div>

    <div class="ns-table-card">
        <div class="table-responsive">
            <table class="ns-table">

                <thead>
                    <tr>
                        <th>Image</th>
                        <th>Product Name</th>
                        <th>Category</th>
                        <th>Price</th>
                        <th>Stock</th>
                        <th>Created By</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    {% for product in products %}
                        <tr>

                            <td>
                                {% if product.imageFilename %}
                                    <img
                                        src="{{ asset('uploads/products/' ~ product.imageFilename) }}"
                                        alt="{{ product.name }}"
                                        class="ns-product-img"
                                        loading="lazy"
                                    >
                                {% else %}
                                    <div class="ns-no-image">
                                        <span style="font-size: 24px;">&#128247;</span>
                                        <span>No Image</span>
                                    </div>
                                {% endif %}
                            </td>

                            <td>
                                <span class="ns-product-name">
                                    {{ product.name }}
                                </span>
                            </td>

                            <td>
                                <span class="ns-category">
                                    {{ product.category }}
                                </span>
                            </td>

                            <td>
                                <span class="ns-price">
                                    ₱{{ product.price|number_format(2) }}
                                </span>
                            </td>

                            <td>
                                <span class="ns-stock {{ product.stock <= 5 ? 'ns-stock-low' : 'ns-stock-ok' }}">
                                    {{ product.stock }}
                                </span>
                            </td>

                            <td>
                                {{ product.createdBy ? product.createdBy.fullName : 'Unknown' }}
                            </td>

                            <td>
                                <div class="ns-action-group">

                                    {% if is_granted('edit', product) %}
                                        <a
                                            href="{{ path('product_edit', {id: product.id}) }}"
                                            class="ns-edit-btn"
                                        >
                                            Edit
                                        </a>
                                    {% endif %}

                                    {% if is_granted('delete', product) %}
                                        <form
                                            method="post"
                                            action="{{ path('product_delete', {id: product.id}) }}"
                                            onsubmit="return confirm('Are you sure you want to delete this product?');"
                                            class="m-0"
                                        >
                                            <input
                                                type="hidden"
                                                name="_token"
                                                value="{{ csrf_token('delete-product-' ~ product.id) }}"
                                            >

                                            <button type="submit" class="ns-delete-btn">
                                                Delete
                                            </button>
                                        </form>
                                    {% endif %}

                                </div>
                            </td>

                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="7" class="ns-empty">
                                <div style="font-size: 35px; margin-bottom: 10px;">
                                    &#128722;
                                </div>
                                <strong>No products found.</strong>
                                <div class="mt-2">
                                    Try changing your search or add a new product.
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>

            </table>
        </div>
    </div>

    <div class="mt-3" style="color: #9A8177; font-size: 13px;">
        Showing {{ products|length }} product(s)
    </div>

</div>
{% endblock %}
