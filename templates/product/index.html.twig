
{% extends 'base.html.twig' %}

{% block title %}Products{% endblock %}

{% block body %}
<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Products</h1>

        <a href="{{ path('product_new') }}" class="btn btn-primary">
            + Add Product
        </a>
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success">{{ message }}</div>
    {% endfor %}

    <form method="get" class="row g-2 mb-4">
        <div class="col-md-5">
            <input
                type="text"
                name="search"
                class="form-control"
                placeholder="Search products..."
                value="{{ search }}"
            >
        </div>

        <div class="col-md-4">
            <input
                type="text"
                name="category"
                class="form-control"
                placeholder="Filter by category"
                value="{{ category }}"
            >
        </div>

        <div class="col-md-3">
            <button class="btn btn-dark" type="submit">Search / Filter</button>
            <a href="{{ path('product_index') }}" class="btn btn-secondary">Reset</a>
        </div>
    </form>

    <div class="table-responsive">
        <table class="table table-bordered table-striped align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Name</th>
                    <th>Category</th>
                    <th>Price</th>
                    <th>Stock</th>
                    <th>Created By</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                {% for product in products %}
                    <tr>
                        <td>{{ product.name }}</td>
                        <td>{{ product.category }}</td>
                        <td>₱{{ product.price|number_format(2) }}</td>
                        <td>{{ product.stock }}</td>
                        <td>{{ product.createdBy.fullName }}</td>
                        <td>
                            {% if is_granted('edit', product) %}
                                <a href="{{ path('product_edit', {id: product.id}) }}"
                                   class="btn btn-sm btn-warning">Edit</a>
                            {% endif %}

                            {% if is_granted('delete', product) %}
                                <form method="post"
                                      action="{{ path('product_delete', {id: product.id}) }}"
                                      class="d-inline"
                                      onsubmit="return confirm('Delete this product?');">
                                    <input type="hidden" name="_token"
                                           value="{{ csrf_token('delete-product-' ~ product.id) }}">
                                    <button class="btn btn-sm btn-danger">Delete</button>
                                </form>
                            {% endif %}
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6" class="text-center">
                            No products found.
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

</div>
{% endblock %}
