
{% extends 'base.html.twig' %}

{% block title %}Edit Product | NS COSMETIQ{% endblock %}

{% block body %}
<div class="container py-4 py-md-5">

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <h1 class="fw-bold mb-1" style="color: #49332D;">
                Edit Product
            </h1>
            <p class="text-muted mb-0">
                Update your product information and image.
            </p>
        </div>

        <a href="{{ path('product_index') }}"
           class="btn btn-outline-secondary">
            Back to Products
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4 p-md-5">

            {{ form_start(form, {
                'attr': {
                    'enctype': 'multipart/form-data'
                }
            }) }}

            {{ form_errors(form) }}

            <div class="row g-3">

                <div class="col-md-6">
                    {{ form_row(form.name) }}
                </div>

                <div class="col-md-6">
                    {{ form_row(form.category) }}
                </div>

                <div class="col-12">
                    {{ form_row(form.description) }}
                </div>

                <div class="col-md-6">
                    {{ form_row(form.price) }}
                </div>

                <div class="col-md-6">
                    {{ form_row(form.stock) }}
                </div>

                <div class="col-12">
                    <h5 class="fw-semibold mt-3"
                        style="color: #49332D;">
                        Product Image
                    </h5>

                    {% if product.imageFilename %}
                        <div class="mb-3">
                            <p class="text-muted small mb-2">
                                Current Image
                            </p>

                            <img
                                src="{{ asset('uploads/products/' ~ product.imageFilename) }}"
                                alt="{{ product.name }}"
                                class="img-thumbnail rounded-3"
                                style="max-width: 180px; max-height: 180px; object-fit: cover;"
                            >
                        </div>
                    {% else %}
                        <p class="text-muted small">
                            No product image uploaded yet.
                        </p>
                    {% endif %}

                    {{ form_row(form.imageFile) }}
                </div>

            </div>

            <div class="d-flex flex-wrap gap-2 mt-4">

                <button type="submit"
                        class="btn text-white px-4 py-2"
                        style="background-color: #C0603F;">
                    Update Product
                </button>

                <a href="{{ path('product_index') }}"
                   class="btn btn-outline-secondary px-4 py-2">
                    Cancel
                </a>

            </div>

            {{ form_end(form) }}

        </div>
    </div>

</div>
{% endblock %}
