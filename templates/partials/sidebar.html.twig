
<aside class="sidebar">

    {# =========================
       NS COSMETIQ ORIGINAL LOGO
       ========================= #}

    <div class="brand">
        <a
            href="{{ path(is_granted('ROLE_ADMIN') ? 'admin_dashboard' : 'staff_dashboard') }}"
            class="brand-logo"
            aria-label="NS COSMETIQ Dashboard"
        >
            <img
                src="{{ asset('images/ns-cosmetiq-logo.png') }}"
                alt="NS COSMETIQ Logo"
            >
        </a>
    </div>

    {% set currentRoute = app.request.attributes.get('_route')|default('') %}

    {% if is_granted('ROLE_ADMIN') %}

        {# =========================
           ADMIN SIDEBAR
           ========================= #}

        <div class="menu-label">Admin Panel</div>

        <nav class="nav flex-column">

            {# DASHBOARD #}
            <a
                class="nav-link {{ currentRoute == 'admin_dashboard' ? 'active' : '' }}"
                href="{{ path('admin_dashboard') }}"
            >
                Dashboard
            </a>

            {# MANAGE PRODUCTS #}
            <a
                class="nav-link {{ currentRoute starts with 'product_' ? 'active' : '' }}"
                href="{{ path('product_index') }}"
            >
                Manage Products
            </a>

            {# MANAGE ORDERS #}
            <a
                class="nav-link {{ currentRoute starts with 'staff_order' ? 'active' : '' }}"
                href="{{ path('staff_orders') }}"
            >
                Manage Orders
            </a>

            {# MANAGE USERS #}
            <a
                class="nav-link {{ currentRoute starts with 'admin_user_' ? 'active' : '' }}"
                href="{{ path('admin_user_index') }}"
            >
                Manage Users
            </a>

        </nav>

    {% elseif is_granted('ROLE_STAFF') %}

        {# =========================
           STAFF SIDEBAR
           ========================= #}

        <div class="menu-label">Staff Panel</div>

        <nav class="nav flex-column">

            {# STAFF DASHBOARD #}
            <a
                class="nav-link {{ currentRoute == 'staff_dashboard' ? 'active' : '' }}"
                href="{{ path('staff_dashboard') }}"
            >
                Dashboard
            </a>

            {# MY PRODUCTS #}
            <a
                class="nav-link {{ currentRoute starts with 'product_' ? 'active' : '' }}"
                href="{{ path('product_index') }}"
            >
                My Products
            </a>

            {# MANAGE ORDERS #}
            <a
                class="nav-link {{ currentRoute starts with 'staff_order' ? 'active' : '' }}"
                href="{{ path('staff_orders') }}"
            >
                Manage Orders
            </a>

        </nav>

    {% endif %}

    {# =========================
       ACCOUNT SECTION
       ========================= #}

    <div class="menu-label">Account</div>

    <nav class="nav flex-column">

        {# MY PROFILE #}
        <a
            class="nav-link {{ currentRoute == 'app_profile' ? 'active' : '' }}"
            href="{{ path('app_profile') }}"
        >
            My Profile
        </a>

        {# CHANGE PASSWORD #}
        <a
            class="nav-link {{ currentRoute == 'app_change_password' ? 'active' : '' }}"
            href="{{ path('app_change_password') }}"
        >
            Change Password
        </a>

        {# BACK TO HOMEPAGE #}
        <a
            class="nav-link"
            href="{{ path('app_home') }}"
        >
            Back to Homepage
        </a>

        {# LOGOUT #}
        <a
            class="nav-link"
            href="{{ path('app_logout') }}"
        >
            Logout
        </a>

    </nav>

</aside>
