
<aside class="sidebar">

    <div class="brand">
        NS COSMETIQ
    </div>

    {% if is_granted('ROLE_ADMIN') %}

        {# =========================
           ADMIN SIDEBAR
           ========================= #}

        <div class="menu-label">Admin Panel</div>

        <nav class="nav flex-column">

            <a class="nav-link
                {% if app.request.attributes.get('_route') == 'admin_dashboard' %}active{% endif %}"
               href="{{ path('admin_dashboard') }}">
                Dashboard
            </a>

            <a class="nav-link
                {% if app.request.attributes.get('_route') starts with 'product_' %}active{% endif %}"
               href="{{ path('product_index') }}">
                Manage Products
            </a>

            <a class="nav-link
                {% if app.request.attributes.get('_route') starts with 'admin_user_' %}active{% endif %}"
               href="{{ path('admin_user_index') }}">
                Manage Users
            </a>

        </nav>

    {% elseif is_granted('ROLE_STAFF') %}

        {# =========================
           STAFF SIDEBAR
           ========================= #}

        <div class="menu-label">Staff Panel</div>

        <nav class="nav flex-column">

            <a class="nav-link
                {% if app.request.attributes.get('_route') == 'staff_dashboard' %}active{% endif %}"
               href="{{ path('staff_dashboard') }}">
                Dashboard
            </a>

            <a class="nav-link
                {% if app.request.attributes.get('_route') starts with 'product_' %}active{% endif %}"
               href="{{ path('product_index') }}">
                My Products
            </a>

        </nav>

    {% endif %}

    {# =========================
       ACCOUNT SECTION
       ========================= #}

    <div class="menu-label">Account</div>

    <nav class="nav flex-column">

        <a class="nav-link
            {% if app.request.attributes.get('_route') == 'app_profile' %}active{% endif %}"
           href="{{ path('app_profile') }}">
            My Profile
        </a>

        <a class="nav-link
            {% if app.request.attributes.get('_route') == 'app_change_password' %}active{% endif %}"
           href="{{ path('app_change_password') }}">
            Change Password
        </a>

        {# BACK TO HOMEPAGE #}
        <a class="nav-link"
           href="{{ path('app_home') }}">
            Back to Homepage
        </a>

        {# LOGOUT #}
        <a class="nav-link"
           href="{{ path('app_logout') }}">
            Logout
        </a>

    </nav>

</aside>
