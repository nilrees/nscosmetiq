
{% extends 'base.html.twig' %}

{% block title %}Staff Dashboard | NS COSMETIQ{% endblock %}

{% block stylesheets %}
{{ parent() }}

<style>
    .staff-dashboard {
        font-family: 'Raleway', sans-serif;
        color: #49332D;
        padding: 20px 5px 50px;
    }

    /* WELCOME BANNER */

    .staff-welcome {
        background: linear-gradient(120deg, #FFF0E9, #F9E3DC);
        border: 1px solid #EED5C9;
        border-radius: 22px;
        padding: 32px;
        margin-bottom: 26px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        flex-wrap: wrap;
    }

    .staff-eyebrow {
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 2px;
        color: #B25B3D;
        margin-bottom: 10px;
    }

    .staff-welcome h1 {
        font-size: clamp(25px, 3vw, 36px);
        font-weight: 800;
        margin-bottom: 10px;
    }

    .staff-welcome p {
        font-size: 14px;
        color: #795C52;
        margin: 0;
    }

    .staff-role-badge {
        background: white;
        border: 1px solid #E9C6B8;
        color: #A65339;
        border-radius: 30px;
        padding: 12px 20px;
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 1px;
    }

    /* STATISTICS */

    .staff-stats {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 18px;
        margin-bottom: 28px;
    }

    .staff-stat-card {
        background: #FFFFFF;
        border: 1px solid #F0DDD5;
        border-radius: 18px;
        padding: 24px;
        transition: transform .2s ease, box-shadow .2s ease;
    }

    .staff-stat-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 28px rgba(73, 51, 45, .08);
    }

    .staff-stat-icon {
        width: 46px;
        height: 46px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #FFF0E9;
        border-radius: 13px;
        font-size: 23px;
        margin-bottom: 18px;
    }

    .staff-stat-icon.stock {
        background: #E6F6EB;
    }

    .staff-stat-icon.low {
        background: #FFF2D9;
    }

    .staff-stat-icon.out {
        background: #FCE7E9;
    }

    .staff-stat-label {
        color: #92756C;
        font-size: 12px;
        font-weight: 700;
        margin-bottom: 10px;
    }

    .staff-stat-number {
        font-size: 34px;
        font-weight: 800;
        line-height: 1.1;
    }

    .staff-stat-note {
        color: #A18A82;
        font-size: 11px;
        margin-top: 9px;
    }

    /* SECTIONS */

    .staff-section {
        background: #FFFFFF;
        border: 1px solid #F0DDD5;
        border-radius: 20px;
        padding: 26px;
        margin-bottom: 26px;
    }

    .staff-section-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        flex-wrap: wrap;
        margin-bottom: 20px;
    }

    .staff-section-heading h2 {
        font-size: 20px;
        font-weight: 800;
        margin: 0;
    }

    .staff-section-heading p {
        color: #92756C;
        font-size: 12px;
        margin: 6px 0 0;
    }

    /* QUICK ACTIONS */

    .staff-actions {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 16px;
    }

    .staff-action-card {
        display: block;
        background: #FFFAF7;
        border: 1px solid #F0DDD5;
        border-radius: 15px;
        padding: 22px;
        color: #49332D;
        text-decoration: none;
        transition: .2s ease;
    }

    .staff-action-card:hover {
        background: #FFF0E9;
        border-color: #DDAE9B;
        transform: translateY(-3px);
        color: #49332D;
    }

    .staff-action-icon {
        font-size: 26px;
        margin-bottom: 14px;
    }

    .staff-action-card h3 {
        font-size: 15px;
        font-weight: 800;
        margin-bottom: 7px;
    }

    .staff-action-card p {
        font-size: 12px;
        line-height: 1.7;
        color: #92756C;
        margin: 0;
    }

    /* PRODUCT TABLE */

    .staff-table {
        width: 100%;
        border-collapse: collapse;
    }

    .staff-table thead {
        background: #FFF1EB;
    }

    .staff-table th {
        padding: 14px 16px;
        font-size: 11px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .6px;
        color: #76584F;
        white-space: nowrap;
    }

    .staff-table td {
        padding: 15px 16px;
        border-bottom: 1px solid #F3E7E1;
        vertical-align: middle;
        font-size: 13px;
    }

    .staff-table tbody tr:last-child td {
        border-bottom: none;
    }

    .staff-product-info {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .staff-product-image {
        width: 54px;
        height: 54px;
        object-fit: cover;
        border-radius: 11px;
        background: #FFF0E9;
        border: 1px solid #F0DDD5;
        flex-shrink: 0;
    }

    .staff-product-placeholder {
        width: 54px;
        height: 54px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #FFF0E9;
        border-radius: 11px;
        font-size: 23px;
        flex-shrink: 0;
    }

    .staff-product-name {
        font-weight: 800;
    }

    .staff-product-category {
        color: #92756C;
        font-size: 11px;
        margin-top: 4px;
    }

    /* STOCK BADGES */

    .staff-stock-badge {
        display: inline-block;
        padding: 7px 11px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 800;
        white-space: nowrap;
    }

    .staff-stock-good {
        background: #E6F6EB;
        color: #26724A;
    }

    .staff-stock-low {
        background: #FFF2D9;
        color: #956017;
    }

    .staff-stock-out {
        background: #FCE7E9;
        color: #AD4350;
    }

    /* BUTTONS */

    .staff-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 11px 18px;
        border-radius: 10px;
        background: #C0603F;
        color: white;
        text-decoration: none;
        font-size: 12px;
        font-weight: 800;
        border: none;
        transition: .2s ease;
        cursor: pointer;
    }

    .staff-btn:hover {
        background: #A34E32;
        color: white;
    }

    .staff-btn-outline {
        background: white;
        color: #49332D;
        border: 1px solid #E9C6B8;
    }

    .staff-btn-outline:hover {
        background: #FFF0E9;
        color: #49332D;
    }

    .staff-btn-delete {
        background: #AF4652;
        color: white;
    }

    .staff-btn-delete:hover {
        background: #913642;
        color: white;
    }

    /* EMPTY STATE */

    .staff-empty {
        text-align: center;
        padding: 45px 20px;
        color: #92756C;
    }

    .staff-empty-icon {
        font-size: 40px;
        margin-bottom: 12px;
    }

    .staff-empty h3 {
        color: #49332D;
        font-size: 18px;
        font-weight: 800;
    }

    /* INVENTORY ALERTS */

    .staff-inventory-alert {
        border-radius: 14px;
        padding: 17px 20px;
        margin-bottom: 14px;
        border: 1px solid;
        font-size: 13px;
        line-height: 1.6;
    }

    .staff-inventory-alert.danger {
        background: #FFF0F1;
        border-color: #F1C6CC;
        color: #963842;
    }

    .staff-inventory-alert.warning {
        background: #FFF7E8;
        border-color: #F2D7A7;
        color: #805616;
    }

    .staff-inventory-alert a {
        color: inherit;
        font-weight: 800;
    }

    .staff-restock-form {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 8px;
    }

    .staff-restock-quantity {
        width: 82px;
        min-height: 38px;
        padding: 7px 9px;
        border: 1px solid #E9C6B8;
        border-radius: 9px;
        color: #49332D;
    }

    .staff-restock-form .staff-btn {
        padding: 9px 12px;
    }

    /* RESPONSIVE DESIGN */

    @media (max-width: 1100px) {
        .staff-stats {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @media (max-width: 768px) {
        .staff-dashboard {
            padding: 15px 0 35px;
        }

        .staff-welcome {
            padding: 24px;
        }

        .staff-section {
            padding: 18px;
        }

        .staff-actions {
            grid-template-columns: 1fr;
        }
    }

    @media (max-width: 480px) {
        .staff-stats {
            grid-template-columns: 1fr;
        }

        .staff-welcome h1 {
            font-size: 25px;
        }

        .staff-btn {
            padding: 9px 12px;
        }
    }
</style>
{% endblock %}

{% block body %}

<div class="staff-dashboard">

    {# WELCOME BANNER #}

    <div class="staff-welcome">

        <div>
            <div class="staff-eyebrow">
                NS COSMETIQ / STAFF WORKSPACE
            </div>

            <h1>
                Welcome back, {{ app.user.fullName }}!
            </h1>

            <p>
                Here's an overview of your products,
                inventory, and recent activity.
            </p>
        </div>

        <span class="staff-role-badge">
            ✦ STAFF ACCOUNT
        </span>

    </div>

    {% for message in app.flashes('error') %}
        <div class="staff-inventory-alert danger" role="alert">{{ message }}</div>
    {% endfor %}

    {% for message in app.flashes('success') %}
        <div class="staff-inventory-alert warning" role="status">{{ message }}</div>
    {% endfor %}

    {# INVENTORY WARNINGS AND RESTOCK TABLE #}

    {% if outOfStock > 0 %}
        <div class="staff-inventory-alert danger" role="alert">
            <strong>Out of Stock Alert!</strong>
            {{ outOfStock }} of your products have zero units remaining.
            <a href="{{ path('product_index') }}">Manage Inventory</a>
        </div>
    {% endif %}

    {% if lowStock > 0 %}
        <div class="staff-inventory-alert warning" role="alert">
            <strong>Low Stock Warning!</strong>
            {{ lowStock }} of your products have only 1–5 units remaining.
            <a href="{{ path('product_index') }}">Manage Inventory</a>
        </div>
    {% endif %}

    {% if outOfStock > 0 or lowStock > 0 %}
        <section class="staff-section" aria-label="Products needing restock">
            <div class="staff-section-heading">
                <div>
                    <h2>Products That Need Restocking</h2>
                    <p>Restock your own products without leaving the dashboard.</p>
                </div>
                <a href="{{ path('product_index') }}" class="staff-btn staff-btn-outline">
                    View All Products
                </a>
            </div>

            <div class="table-responsive">
                <table class="staff-table">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th>Remaining Stock</th>
                            <th>Status</th>
                            <th>Restock</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for product in outOfStockProducts|merge(lowStockProducts) %}
                            <tr>
                                <td>
                                    <span class="staff-product-name">{{ product.name }}</span>
                                </td>
                                <td>{{ product.stock }}</td>
                                <td>
                                    {% if product.stock == 0 %}
                                        <span class="staff-stock-badge staff-stock-out">Out of Stock</span>
                                    {% else %}
                                        <span class="staff-stock-badge staff-stock-low">Low Stock</span>
                                    {% endif %}
                                </td>
                                <td>
                                    {% if is_granted('edit', product) %}
                                        <form method="post"
                                              action="{{ path('product_restock', {id: product.id}) }}"
                                              class="staff-restock-form">
                                            <input type="hidden"
                                                   name="_token"
                                                   value="{{ csrf_token('restock-product-' ~ product.id) }}">
                                            <input type="number"
                                                   name="quantity"
                                                   min="1"
                                                   step="1"
                                                   required
                                                   class="staff-restock-quantity"
                                                   aria-label="Restock quantity for {{ product.name }}"
                                                   placeholder="Qty">
                                            <button type="submit" class="staff-btn">Restock</button>
                                        </form>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </section>
    {% endif %}

    {# DASHBOARD STATISTICS #}

    <div class="staff-stats">

        <div class="staff-stat-card">
            <div class="staff-stat-icon">📦</div>

            <div class="staff-stat-label">
                My Products
            </div>

            <div class="staff-stat-number">
                {{ totalProducts }}
            </div>

            <div class="staff-stat-note">
                Products you created
            </div>
        </div>

        <div class="staff-stat-card">
            <div class="staff-stat-icon stock">🛍️</div>

            <div class="staff-stat-label">
                Total Stock
            </div>

            <div class="staff-stat-number">
                {{ totalStock }}
            </div>

            <div class="staff-stat-note">
                Available inventory units
            </div>
        </div>

        <div class="staff-stat-card">
            <div class="staff-stat-icon low">⚠️</div>

            <div class="staff-stat-label">
                Low Stock
            </div>

            <div class="staff-stat-number">
                {{ lowStock }}
            </div>

            <div class="staff-stat-note">
                Products with 1–5 units
            </div>
        </div>

        <div class="staff-stat-card">
            <div class="staff-stat-icon out">🚫</div>

            <div class="staff-stat-label">
                Out of Stock
            </div>

            <div class="staff-stat-number">
                {{ outOfStock }}
            </div>

            <div class="staff-stat-note">
                Products with zero units
            </div>
        </div>

    </div>


{# STAFF ORDER STATISTICS #}
<div class="staff-section">

    <div class="staff-section-heading">
        <div>
            <h2>My Order Overview</h2>
            <p>Orders assigned to your products.</p>
        </div>

        <a href="{{ path('staff_orders') }}"
           class="staff-btn">
            View Orders
        </a>
    </div>

    <div class="staff-stats">

        <div class="staff-stat-card">
            <div class="staff-stat-icon">📦</div>
            <div class="staff-stat-label">My Orders</div>
            <div class="staff-stat-number">
                {{ totalOrders|default(0) }}
            </div>
        </div>

        <div class="staff-stat-card">
            <div class="staff-stat-icon low">⏳</div>
            <div class="staff-stat-label">Pending</div>
            <div class="staff-stat-number">
                {{ pendingOrders|default(0) }}
            </div>
        </div>

        <div class="staff-stat-card">
            <div class="staff-stat-icon stock">🚚</div>
            <div class="staff-stat-label">Processing</div>
            <div class="staff-stat-number">
                {{ processingOrders|default(0) }}
            </div>
        </div>

    </div>
</div>


    {# QUICK ACTIONS #}

    <div class="staff-section">

        <div class="staff-section-heading">
            <div>
                <h2>Quick Actions</h2>

                <p>
                    Everything you need to manage your products.
                </p>
            </div>
        </div>

        <div class="staff-actions">


<a href="{{ path('staff_orders') }}"
   class="staff-action-card">

    <div class="staff-action-icon">🛍️</div>

    <h3>Manage Orders</h3>

    <p>
        View customer purchases containing your products
        and update eligible order statuses.
    </p>

</a>


            <a href="{{ path('product_new') }}"
               class="staff-action-card">

                <div class="staff-action-icon">✨</div>

                <h3>Add New Product</h3>

                <p>
                    Add a new NS COSMETIQ product,
                    upload its picture, and set its price.
                </p>

            </a>

            <a href="{{ path('product_index') }}"
               class="staff-action-card">

                <div class="staff-action-icon">📦</div>

                <h3>Manage My Products</h3>

                <p>
                    View your own product records,
                    update stock, and manage listings.
                </p>

            </a>

            <a href="{{ path('app_profile') }}"
               class="staff-action-card">

                <div class="staff-action-icon">👤</div>

                <h3>My Profile</h3>

                <p>
                    View and manage your personal
                    account information.
                </p>

            </a>

            <a href="{{ path('app_change_password') }}"
               class="staff-action-card">

                <div class="staff-action-icon">🔐</div>

                <h3>Change Password</h3>

                <p>
                    Keep your NS COSMETIQ staff account
                    secure by updating your password.
                </p>

            </a>

        </div>

    </div>

    {# RECENT PRODUCTS #}

    <div class="staff-section">

        <div class="staff-section-heading">

            <div>
                <h2>My Recent Products</h2>

                <p>
                    Your five most recently added products.
                </p>
            </div>

            <a href="{{ path('product_index') }}"
               class="staff-btn staff-btn-outline">
                View All Products
            </a>

        </div>

        {% if recentProducts is not empty %}

            <div class="table-responsive">

                <table class="staff-table">

                    <thead>
                        <tr>
                            <th>Product</th>
                            <th>Price</th>
                            <th>Stock</th>
                            <th>Date Added</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                    {% for product in recentProducts %}

                        <tr>

                            <td>
                                <div class="staff-product-info">

                                    {% if product.imageFilename %}
                                        <img
                                            src="{{ asset('uploads/products/' ~ product.imageFilename) }}"
                                            alt="{{ product.name }}"
                                            class="staff-product-image"
                                            loading="lazy"
                                        >
                                    {% else %}
                                        <div class="staff-product-placeholder">
                                            💄
                                        </div>
                                    {% endif %}

                                    <div>
                                        <div class="staff-product-name">
                                            {{ product.name }}
                                        </div>

                                        <div class="staff-product-category">
                                            {{ product.category }}
                                        </div>
                                    </div>

                                </div>
                            </td>

                            <td>
                                ₱{{ product.price|number_format(2) }}
                            </td>

                            <td>
                                {% if product.stock == 0 %}
                                    <span class="staff-stock-badge staff-stock-out">
                                        Out of Stock
                                    </span>
                                {% elseif product.stock <= 5 %}
                                    <span class="staff-stock-badge staff-stock-low">
                                        Low: {{ product.stock }}
                                    </span>
                                {% else %}
                                    <span class="staff-stock-badge staff-stock-good">
                                        {{ product.stock }} Available
                                    </span>
                                {% endif %}
                            </td>

                            <td>
                                {{ product.createdAt|date('M d, Y') }}
                            </td>

                            <td>
                                <div class="d-flex flex-wrap gap-2">

                                    {% if is_granted('edit', product) %}
                                        <a
                                            href="{{ path('product_edit', {
                                                id: product.id
                                            }) }}"
                                            class="staff-btn staff-btn-outline"
                                        >
                                            Edit
                                        </a>
                                    {% endif %}

                                    {% if is_granted('delete', product) %}
                                        <form
                                            method="post"
                                            action="{{ path('product_delete', {
                                                id: product.id
                                            }) }}"
                                            onsubmit="return confirm('Are you sure you want to delete this product?');"
                                            class="m-0"
                                        >

                                            <input
                                                type="hidden"
                                                name="_token"
                                                value="{{ csrf_token('delete-product-' ~ product.id) }}"
                                            >

                                            <button
                                                type="submit"
                                                class="staff-btn staff-btn-delete"
                                            >
                                                Delete
                                            </button>

                                        </form>
                                    {% endif %}

                                </div>
                            </td>

                        </tr>

                    {% endfor %}

                    </tbody>

                </table>

            </div>

        {% else %}

            <div class="staff-empty">

                <div class="staff-empty-icon">🛍️</div>

                <h3>No Products Yet</h3>

                <p>
                    You haven't added any products.
                    Start by creating your first product.
                </p>

                <a href="{{ path('product_new') }}"
                   class="staff-btn">
                    + Add Your First Product
                </a>

            </div>

        {% endif %}

    </div>

</div>

{% endblock %}
