
{% extends 'base.html.twig' %}

{% block title %}Admin Dashboard | NS COSMETIQ{% endblock %}

{% block stylesheets %}
    {{ parent() }}

    <style>
        .ns-dashboard {
            color: #49332D;
            padding: 20px 5px 50px;
        }

        .ns-dashboard-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
            flex-wrap: wrap;
            margin-bottom: 30px;
            padding-bottom: 22px;
            border-bottom: 1px solid #EBD7D0;
        }

        .ns-dashboard-header h1 {
            font-size: clamp(26px, 3vw, 36px);
            font-weight: 800;
            margin: 0 0 8px;
        }

        .ns-dashboard-header p {
            color: #92776D;
            margin: 0;
        }

        .ns-accent {
            color: #C0603F;
        }

        .ns-action {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 12px 20px;
            background: #C0603F;
            color: #FFFFFF;
            border-radius: 12px;
            text-decoration: none;
            font-weight: 700;
            transition: 0.2s;
            border: none;
        }

        .ns-action:hover {
            background: #9E492D;
            color: #FFFFFF;
            transform: translateY(-2px);
        }

        .ns-stat-card {
            background: #FFFFFF;
            border: 1px solid #F0DDD5;
            border-radius: 18px;
            padding: 25px;
            height: 100%;
            min-height: 155px;
            box-shadow: 0 8px 25px rgba(93, 57, 45, 0.045);
        }

        .ns-stat-icon {
            width: 48px;
            height: 48px;
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 23px;
            margin-bottom: 15px;
            background: #FBE8E1;
        }

        .ns-stat-icon.staff {
            background: #F4E7F0;
        }

        .ns-stat-icon.products {
            background: #F8EBD6;
        }

        .ns-stat-icon.stock {
            background: #E4F1E9;
        }

        .ns-stat-icon.low {
            background: #FFF0D6;
        }

        .ns-stat-icon.out {
            background: #FCE2E5;
        }

        .ns-stat-value {
            font-size: 35px;
            font-weight: 800;
            line-height: 1.2;
        }

        .ns-stat-label {
            color: #987A70;
            font-size: 13px;
            font-weight: 700;
            margin-top: 7px;
        }

        .ns-section-title {
            font-size: 22px;
            font-weight: 800;
            margin: 35px 0 20px;
        }

        .ns-feature-card {
            display: block;
            height: 100%;
            padding: 25px;
            background: #FFFFFF;
            border: 1px solid #F0DDD5;
            border-radius: 18px;
            text-decoration: none;
            color: #49332D;
            transition: 0.2s;
        }

        .ns-feature-card:hover {
            transform: translateY(-4px);
            border-color: #C0603F;
            box-shadow: 0 12px 30px rgba(93, 57, 45, 0.09);
            color: #49332D;
        }

        .ns-feature-icon {
            font-size: 30px;
            margin-bottom: 15px;
        }

        .ns-feature-card h3 {
            font-size: 18px;
            font-weight: 800;
        }

        .ns-feature-card p {
            color: #92776D;
            font-size: 13px;
            margin-bottom: 0;
        }

        .ns-panel {
            background: #FFFFFF;
            border: 1px solid #F0DDD5;
            border-radius: 18px;
            overflow: hidden;
            margin-top: 30px;
        }

        .ns-panel-header {
            padding: 20px 24px;
            border-bottom: 1px solid #F0DDD5;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 12px;
        }

        .ns-panel-header h2 {
            font-size: 19px;
            font-weight: 800;
            margin: 0;
        }

        .ns-panel-link {
            color: #C0603F;
            font-size: 13px;
            font-weight: 700;
            text-decoration: none;
        }

        .ns-product-row {
            padding: 15px 24px;
            border-bottom: 1px solid #F6EAE5;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 15px;
        }

        .ns-product-row:last-child {
            border-bottom: 0;
        }

        .ns-product-info {
            display: flex;
            align-items: center;
            gap: 14px;
            min-width: 0;
        }

        .ns-product-image {
            width: 55px;
            height: 55px;
            border-radius: 12px;
            object-fit: cover;
            border: 1px solid #F0DDD5;
            flex-shrink: 0;
        }

        .ns-image-placeholder {
            width: 55px;
            height: 55px;
            border-radius: 12px;
            background: #FBE8E1;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 25px;
            flex-shrink: 0;
        }

        .ns-product-row strong {
            font-size: 14px;
            display: block;
        }

        .ns-product-row span {
            font-size: 12px;
            color: #987A70;
        }

        .ns-product-price {
            font-weight: 800;
            color: #C0603F;
            white-space: nowrap;
        }

        .ns-empty {
            text-align: center;
            padding: 35px;
            color: #987A70;
        }

        @media (max-width: 768px) {
            .ns-dashboard {
                padding: 15px 0 35px;
            }

            .ns-dashboard-header {
                align-items: flex-start;
            }

            .ns-action {
                width: 100%;
            }

            .ns-stat-card {
                padding: 20px;
                min-height: 140px;
            }

            .ns-stat-value {
                font-size: 30px;
            }

            .ns-feature-card {
                padding: 20px;
            }

            .ns-product-row {
                padding: 15px;
            }
        }

        /* INVENTORY ALERTS */
        .ns-inventory-alert { border-radius: 14px; padding: 16px 20px; margin-bottom: 14px; border: 1px solid; }
        .ns-inventory-alert.out { background: #FFF1F1; border-color: #F1C9CD; color: #963642; }
        .ns-inventory-alert.low { background: #FFF7E8; border-color: #F2DCA9; color: #795414; }
        .ns-inventory-alert a { color: inherit; font-weight: 800; }
        .ns-inventory-table { width: 100%; border-collapse: collapse; }
        .ns-inventory-table th, .ns-inventory-table td { padding: 13px 18px; border-bottom: 1px solid #F3E7E1; vertical-align: middle; }
        .ns-inventory-table th { background: #FFF1EB; font-size: 12px; color: #76584F; }
        .ns-inventory-table tr:last-child td { border-bottom: 0; }
        .ns-inventory-badge { display: inline-block; padding: 6px 10px; border-radius: 20px; font-size: 11px; font-weight: 800; }
        .ns-inventory-badge.out { background: #FCE2E5; color: #AD4350; }
        .ns-inventory-badge.low { background: #FFF0D6; color: #956017; }
        .ns-restock-form { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
        .ns-restock-form input { width: 85px; padding: 9px; border: 1px solid #E9C6B8; border-radius: 9px; }
        .ns-restock-form button { background: #C0603F; color: white; border: 0; border-radius: 9px; padding: 10px 14px; font-weight: 700; }
        .ns-restock-form button:hover { background: #9E492D; }

        /* SALES REPORTING */
        .ns-sales-note { color: #92776D; font-size: 13px; margin: -10px 0 18px; }
        .ns-sales-card { background: #fff; border: 1px solid #F0DDD5; border-radius: 18px; padding: 23px; height: 100%; box-shadow: 0 8px 25px rgba(93,57,45,.045); }
        .ns-sales-card .ns-sales-label { color: #987A70; font-size: 12px; font-weight: 800; letter-spacing: .3px; }
        .ns-sales-card .ns-sales-value { color: #49332D; font-size: clamp(23px,2.5vw,31px); font-weight: 800; margin-top: 10px; overflow-wrap: anywhere; }
        .ns-sales-card .ns-sales-icon { font-size: 23px; margin-bottom: 10px; }
        .ns-chart-content { padding: 24px; }
        .ns-chart-row { display: grid; grid-template-columns: 78px minmax(0,1fr) 125px; gap: 14px; align-items: center; margin-bottom: 17px; font-size: 12px; }
        .ns-chart-track { background: #FFF1EB; height: 18px; border-radius: 30px; overflow: hidden; }
        .ns-chart-fill { height: 100%; background: linear-gradient(90deg,#E7A48C,#C0603F); border-radius: 30px; min-width: 0; }
        .ns-chart-value { text-align: right; font-weight: 800; color: #49332D; }
        .ns-sales-table { width: 100%; border-collapse: collapse; }
        .ns-sales-table th { background: #FFF1EB; color: #76584F; font-size: 12px; }
        .ns-sales-table th, .ns-sales-table td { padding: 14px 18px; border-bottom: 1px solid #F3E7E1; }
        .ns-sales-table tbody tr:last-child td { border-bottom: 0; }
        @media (max-width: 600px) { .ns-chart-row { grid-template-columns: 62px minmax(0,1fr); } .ns-chart-value { grid-column: 2; text-align: left; margin-top: -9px; } }
    </style>
{% endblock %}

{% block body %}
<div class="ns-dashboard">

    <div class="ns-dashboard-header">
        <div>
            <h1>
                ✦ <span class="ns-accent">Beauty</span> Management
            </h1>

            <p>
                Welcome to NS COSMETIQ.
                Manage your beauty collection, staff, and store.
            </p>
        </div>

        <a href="{{ path('product_new') }}" class="ns-action">
            + Add New Product
        </a>
    </div>

    {# INVENTORY ALERTS #}
    {% for message in app.flashes('success') %}
        <div class="alert alert-success rounded-3" role="status">{{ message }}</div>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <div class="alert alert-danger rounded-3" role="alert">{{ message }}</div>
    {% endfor %}

    {% if outOfStock > 0 %}
        <div class="ns-inventory-alert out" role="alert">
            <strong>Out of Stock Alert!</strong>
            {{ outOfStock }} product(s) have no remaining stock.
            <a href="{{ path('product_index') }}">Manage Inventory</a>
        </div>
    {% endif %}
    {% if lowStock > 0 %}
        <div class="ns-inventory-alert low" role="status">
            <strong>Low Stock Warning!</strong>
            {{ lowStock }} product(s) have only 1–5 units remaining.
            <a href="{{ path('product_index') }}">View Products</a>
        </div>
    {% endif %}

    {% if lowStock > 0 or outOfStock > 0 %}
        <section class="ns-panel" aria-label="Products requiring restocking">
            <div class="ns-panel-header">
                <h2>Products That Need Restocking</h2>
                <a href="{{ path('product_index') }}" class="ns-panel-link">Manage All Products</a>
            </div>
            <div class="table-responsive">
                <table class="ns-inventory-table">
                    <thead><tr><th>Product</th><th>Remaining Stock</th><th>Status</th><th>Restock</th></tr></thead>
                    <tbody>
                    {% for product in outOfStockProducts|merge(lowStockProducts) %}
                        <tr>
                            <td><strong>{{ product.name }}</strong></td>
                            <td>{{ product.stock }}</td>
                            <td>
                                {% if product.stock == 0 %}
                                    <span class="ns-inventory-badge out">Out of Stock</span>
                                {% else %}
                                    <span class="ns-inventory-badge low">Low Stock</span>
                                {% endif %}
                            </td>
                            <td>
                                {% if is_granted('edit', product) %}
                                    <form method="post" action="{{ path('product_restock', {id: product.id}) }}" class="ns-restock-form">
                                        <input type="hidden" name="_token" value="{{ csrf_token('restock-product-' ~ product.id) }}">
                                        <input type="number" name="quantity" min="1" step="1" required placeholder="Qty" aria-label="Quantity to restock for {{ product.name }}">
                                        <button type="submit">Restock</button>
                                    </form>
                                {% else %}
                                    <span class="text-muted">Not authorized</span>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </section>
    {% endif %}

    {# DASHBOARD STATISTICS #}
    <div class="row g-4">

        <div class="col-12 col-sm-6 col-xl-4">
            <div class="ns-stat-card">
                <div class="ns-stat-icon">👥</div>
                <div class="ns-stat-value">{{ totalUsers }}</div>
                <div class="ns-stat-label">TOTAL USERS</div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-4">
            <div class="ns-stat-card">
                <div class="ns-stat-icon staff">🪪</div>
                <div class="ns-stat-value">{{ totalStaff }}</div>
                <div class="ns-stat-label">TOTAL STAFF</div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-4">
            <div class="ns-stat-card">
                <div class="ns-stat-icon products">🛍️</div>
                <div class="ns-stat-value">{{ totalRecords }}</div>
                <div class="ns-stat-label">TOTAL PRODUCTS</div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-4">
            <div class="ns-stat-card">
                <div class="ns-stat-icon stock">📦</div>
                <div class="ns-stat-value">{{ totalStock }}</div>
                <div class="ns-stat-label">TOTAL STOCK UNITS</div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-4">
            <div class="ns-stat-card">
                <div class="ns-stat-icon low">⚠️</div>
                <div class="ns-stat-value">{{ lowStock }}</div>
                <div class="ns-stat-label">LOW STOCK PRODUCTS (1–5)</div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-4">
            <div class="ns-stat-card">
                <div class="ns-stat-icon out">🚫</div>
                <div class="ns-stat-value">{{ outOfStock }}</div>
                <div class="ns-stat-label">OUT OF STOCK PRODUCTS</div>
            </div>
        </div>

    </div>


    {# STEP 21: SALES AND REVENUE REPORTS #}
    <h2 class="ns-section-title">Sales &amp; Revenue Overview</h2>
    <p class="ns-sales-note">Completed sales are based on Delivered orders only. For COD orders, this is not proof that payment was collected.</p>

    <div class="row g-4">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="ns-sales-card">
                <div class="ns-sales-icon">💰</div>
                <div class="ns-sales-label">DELIVERED ORDER REVENUE</div>
                <div class="ns-sales-value">₱{{ totalRevenue|default(0)|number_format(2) }}</div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="ns-sales-card">
                <div class="ns-sales-icon">✅</div>
                <div class="ns-sales-label">DELIVERED ORDERS</div>
                <div class="ns-sales-value">{{ completedOrderCount|default(0) }}</div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="ns-sales-card">
                <div class="ns-sales-icon">🛍️</div>
                <div class="ns-sales-label">PRODUCT UNITS SOLD</div>
                <div class="ns-sales-value">{{ totalProductsSold|default(0) }}</div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="ns-sales-card">
                <div class="ns-sales-icon">📊</div>
                <div class="ns-sales-label">AVERAGE DELIVERED ORDER VALUE</div>
                <div class="ns-sales-value">₱{{ averageOrderValue|default(0)|number_format(2) }}</div>
            </div>
        </div>
    </div>

    <section class="ns-panel" aria-label="Monthly sales report">
        <div class="ns-panel-header"><h2>Monthly Sales Trend</h2></div>
        <div class="ns-chart-content">
            <p class="ns-sales-note">Revenue from delivered orders, grouped by the month the order was placed.</p>
            {% set highestMonthlyRevenue = 0 %}
            {% for month, revenue in monthlySales|default([]) %}
                {% if revenue > highestMonthlyRevenue %}
                    {% set highestMonthlyRevenue = revenue %}
                {% endif %}
            {% endfor %}
            {% for month, revenue in monthlySales|default([]) %}
                {% set barWidth = highestMonthlyRevenue > 0 ? (revenue / highestMonthlyRevenue * 100) : 0 %}
                <div class="ns-chart-row">
                    <strong>{{ month }}</strong>
                    <div class="ns-chart-track" role="img" aria-label="{{ month }}: ₱{{ revenue|number_format(2) }}">
                        <div class="ns-chart-fill" style="width: {{ barWidth|round(1) }}%;"></div>
                    </div>
                    <span class="ns-chart-value">₱{{ revenue|number_format(2) }}</span>
                </div>
            {% else %}
                <div class="ns-empty">No delivered-order sales to display yet.</div>
            {% endfor %}
        </div>
    </section>

    <section class="ns-panel" aria-label="Best-selling products">
        <div class="ns-panel-header"><h2>🏆 Top 5 Best-Selling Products</h2></div>
        <div class="table-responsive">
            <table class="ns-sales-table">
                <thead><tr><th>Rank</th><th>Product</th><th>Units Sold</th><th>Item Revenue</th></tr></thead>
                <tbody>
                    {% for item in bestSellingProducts|default([]) %}
                        <tr>
                            <td>{{ loop.index }}</td>
                            <td><strong>{{ item.product.name }}</strong></td>
                            <td>{{ item.quantity }}</td>
                            <td>₱{{ item.revenue|number_format(2) }}</td>
                        </tr>
                    {% else %}
                        <tr><td colspan="4" class="ns-empty">No delivered-order products to report yet.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </section>

{# ORDER STATISTICS #}
<h2 class="ns-section-title">Order Overview</h2>

<div class="row g-4">

    <div class="col-12 col-sm-6 col-xl-4">
        <div class="ns-stat-card">
            <div class="ns-stat-icon">📦</div>
            <div class="ns-stat-value">
                {{ totalOrders|default(0) }}
            </div>
            <div class="ns-stat-label">TOTAL ORDERS</div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-4">
        <div class="ns-stat-card">
            <div class="ns-stat-icon low">⏳</div>
            <div class="ns-stat-value">
                {{ pendingOrders|default(0) }}
            </div>
            <div class="ns-stat-label">PENDING ORDERS</div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-4">
        <div class="ns-stat-card">
            <div class="ns-stat-icon stock">🚚</div>
            <div class="ns-stat-value">
                {{ processingOrders|default(0) }}
            </div>
            <div class="ns-stat-label">PROCESSING ORDERS</div>
        </div>
    </div>

</div>

    {# MANAGEMENT LINKS #}
    <h2 class="ns-section-title">Store Management</h2>

    <div class="row g-4">


<div class="col-12 col-md-6 col-xl-4">
    <a href="{{ path('staff_orders') }}" class="ns-feature-card">
        <div class="ns-feature-icon">🛍️</div>
        <h3>Manage Orders</h3>
        <p>View customer orders and update delivery statuses.</p>
    </a>
</div>


        <div class="col-12 col-md-6 col-xl-4">
            <a href="{{ path('product_index') }}" class="ns-feature-card">
                <div class="ns-feature-icon">💄</div>
                <h3>Product Collection</h3>
                <p>View, add, update, and manage all products.</p>
            </a>
        </div>

        <div class="col-12 col-md-6 col-xl-4">
            <a href="{{ path('admin_user_index') }}" class="ns-feature-card">
                <div class="ns-feature-icon">👥</div>
                <h3>Users & Roles</h3>
                <p>Manage staff accounts, permissions, and access.</p>
            </a>
        </div>

        <div class="col-12 col-md-6 col-xl-4">
            <a href="{{ path('product_new') }}" class="ns-feature-card">
                <div class="ns-feature-icon">✨</div>
                <h3>Add New Product</h3>
                <p>Add beauty essentials to your collection.</p>
            </a>
        </div>

        <div class="col-12 col-md-6 col-xl-4">
            <a href="{{ path('app_profile') }}" class="ns-feature-card">
                <div class="ns-feature-icon">👤</div>
                <h3>My Profile</h3>
                <p>View and manage your account information.</p>
            </a>
        </div>

        <div class="col-12 col-md-6 col-xl-4">
            <a href="{{ path('app_change_password') }}" class="ns-feature-card">
                <div class="ns-feature-icon">🔐</div>
                <h3>Security & Password</h3>
                <p>Keep your administrator account secure.</p>
            </a>
        </div>

        <div class="col-12 col-md-6 col-xl-4">
            <a href="{{ path('app_home') }}" class="ns-feature-card">
                <div class="ns-feature-icon">🏬</div>
                <h3>Visit Customer Store</h3>
                <p>Preview the public NS COSMETIQ website.</p>
            </a>
        </div>

    </div>

    
{# RECENT CUSTOMER ORDERS #}
<div class="ns-panel">

    <div class="ns-panel-header">
        <h2>Recent Customer Orders</h2>

        <a href="{{ path('staff_orders') }}"
           class="ns-panel-link">
            View All Orders
        </a>
    </div>

    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th class="ps-4">Order ID</th>
                    <th>Customer</th>
                    <th>Total</th>
                    <th>Status</th>
                    <th>Date</th>
                </tr>
            </thead>

            <tbody>
                {% for order in recentOrders %}
                    <tr>
                        <td class="ps-4">
                            <strong>#{{ order.id }}</strong>
                        </td>

                        <td>
                            {{ order.customer.email }}
                        </td>

                        <td>
                            ₱{{ order.totalAmount|number_format(2) }}
                        </td>

                        <td>
                            {% set statusColors = {
                                'Pending': 'warning',
                                'Processing': 'info',
                                'Shipped': 'primary',
                                'Delivered': 'success',
                                'Cancelled': 'danger'
                            } %}

                            <span class="badge text-bg-{{ statusColors[order.status]|default('secondary') }}">
                                {{ order.status }}
                            </span>
                        </td>

                        <td>
                            {{ order.createdAt|date('M d, Y') }}
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="5" class="text-center py-4">
                            No customer orders yet.
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

</div>


    {# RECENT PRODUCTS #}
    <div class="ns-panel">

        <div class="ns-panel-header">
            <h2>✨ Recently Added Products</h2>

            <a href="{{ path('product_index') }}" class="ns-panel-link">
                View All Products
            </a>
        </div>

        {% for product in recentProducts %}

            <div class="ns-product-row">

                <div class="ns-product-info">

                    {% if product.imageFilename %}
                        <img
                            src="{{ asset('uploads/products/' ~ product.imageFilename) }}"
                            alt="{{ product.name }}"
                            class="ns-product-image"
                            loading="lazy"
                        >
                    {% else %}
                        <div class="ns-image-placeholder">💄</div>
                    {% endif %}

                    <div>
                        <strong>{{ product.name }}</strong>
                        <span>
                            {{ product.category }}
                            · Stock: {{ product.stock }}
                        </span>
                    </div>

                </div>

                <div class="ns-product-price">
                    ₱{{ product.price|number_format(2) }}
                </div>

            </div>

        {% else %}

            <div class="ns-empty">
                No products have been added yet.

                <div class="mt-3">
                    <a href="{{ path('product_new') }}" class="ns-action">
                        Add First Product
                    </a>
                </div>
            </div>

        {% endfor %}

    </div>

</div>
{% endblock %}
