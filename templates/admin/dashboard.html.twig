
{% extends 'base.html.twig' %}

{% block title %}Admin Dashboard | NS COSMETIQ{% endblock %}

{% block stylesheets %}
<style>
    .ns-dashboard {
        color: #49332D;
    }

    .ns-dashboard-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        flex-wrap: wrap;
        margin-bottom: 30px;
        padding-bottom: 22px;
        border-bottom: 1px solid #EBD7D0;
    }

    .ns-dashboard-header h1 {
        font-size: clamp(26px, 3vw, 36px);
        font-weight: 800;
        margin: 0 0 8px;
    }

    .ns-dashboard-header p {
        color: #92776D;
        margin: 0;
    }

    .ns-accent {
        color: #C0603F;
    }

    .ns-action {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 12px 20px;
        background: #C0603F;
        color: #fff;
        border-radius: 12px;
        text-decoration: none;
        font-weight: 700;
        transition: .2s;
    }

    .ns-action:hover {
        background: #9E492D;
        color: #fff;
        transform: translateY(-2px);
    }

    .ns-stat-card {
        background: #FFFFFF;
        border: 1px solid #F0DDD5;
        border-radius: 18px;
        padding: 25px;
        min-height: 155px;
        box-shadow: 0 8px 25px rgba(93, 57, 45, .045);
    }

    .ns-stat-icon {
        width: 48px;
        height: 48px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 23px;
        margin-bottom: 15px;
    }

    .ns-stat-icon.users {
        background: #FBE8E1;
    }

    .ns-stat-icon.staff {
        background: #F4E7F0;
    }

    .ns-stat-icon.products {
        background: #F8EBD6;
    }

    .ns-stat-value {
        font-size: 35px;
        font-weight: 800;
        line-height: 1.2;
    }

    .ns-stat-label {
        color: #987A70;
        font-size: 13px;
        font-weight: 700;
        margin-top: 7px;
    }

    .ns-section-title {
        font-size: 22px;
        font-weight: 800;
        margin: 35px 0 20px;
    }

    .ns-feature-card {
        display: block;
        height: 100%;
        padding: 25px;
        background: #FFFFFF;
        border: 1px solid #F0DDD5;
        border-radius: 18px;
        text-decoration: none;
        color: #49332D;
        transition: .2s;
    }

    .ns-feature-card:hover {
        transform: translateY(-4px);
        border-color: #C0603F;
        box-shadow: 0 12px 30px rgba(93, 57, 45, .09);
        color: #49332D;
    }

    .ns-feature-icon {
        font-size: 30px;
        margin-bottom: 15px;
    }

    .ns-feature-card h3 {
        font-size: 18px;
        font-weight: 800;
    }

    .ns-feature-card p {
        color: #92776D;
        font-size: 13px;
        margin-bottom: 0;
    }

    .ns-panel {
        background: #FFFFFF;
        border: 1px solid #F0DDD5;
        border-radius: 18px;
        overflow: hidden;
        margin-top: 30px;
    }

    .ns-panel-header {
        padding: 20px 24px;
        border-bottom: 1px solid #F0DDD5;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
    }

    .ns-panel-header h2 {
        font-size: 19px;
        font-weight: 800;
        margin: 0;
    }

    .ns-panel-link {
        color: #C0603F;
        font-size: 13px;
        font-weight: 700;
        text-decoration: none;
    }

    .ns-product-row {
        padding: 15px 24px;
        border-bottom: 1px solid #F6EAE5;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
    }

    .ns-product-row:last-child {
        border-bottom: 0;
    }

    .ns-product-row strong {
        font-size: 14px;
    }

    .ns-product-row span {
        font-size: 12px;
        color: #987A70;
    }

    .ns-empty {
        text-align: center;
        padding: 35px;
        color: #987A70;
    }
</style>
{% endblock %}

{% block body %}
<div class="ns-dashboard">

    <div class="ns-dashboard-header">
        <div>
            <h1>✦ <span class="ns-accent">Beauty</span> Management</h1>
            <p>
                Welcome to NS COSMETIQ.
                Manage your beauty collection, staff, and store.
            </p>
        </div>

        <a href="{{ path('product_new') }}" class="ns-action">
            + Add New Product
        </a>
    </div>

    <div class="row g-4">
        <div class="col-12 col-md-4">
            <div class="ns-stat-card">
                <div class="ns-stat-icon users">👥</div>
                <div class="ns-stat-value">{{ totalUsers }}</div>
                <div class="ns-stat-label">TOTAL USERS</div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="ns-stat-card">
                <div class="ns-stat-icon staff">🪪</div>
                <div class="ns-stat-value">{{ totalStaff }}</div>
                <div class="ns-stat-label">TOTAL STAFF</div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="ns-stat-card">
                <div class="ns-stat-icon products">🛍️</div>
                <div class="ns-stat-value">{{ totalRecords }}</div>
                <div class="ns-stat-label">TOTAL PRODUCTS</div>
            </div>
        </div>
    </div>

    <h2 class="ns-section-title">Store Management</h2>

    <div class="row g-4">
        <div class="col-12 col-md-6 col-xl-4">
            <a href="{{ path('product_index') }}" class="ns-feature-card">
                <div class="ns-feature-icon">💄</div>
                <h3>Product Collection</h3>
                <p>
                    View, add, update, and manage NS COSMETIQ products.
                </p>
            </a>
        </div>

        <div class="col-12 col-md-6 col-xl-4">
            <a href="{{ path('admin_user_index') }}" class="ns-feature-card">
                <div class="ns-feature-icon">👥</div>
                <h3>Users & Roles</h3>
                <p>
                    Manage staff accounts, permissions, and user access.
                </p>
            </a>
        </div>

        <div class="col-12 col-md-6 col-xl-4">
            <a href="{{ path('product_new') }}" class="ns-feature-card">
                <div class="ns-feature-icon">✨</div>
                <h3>Add New Product</h3>
                <p>
                    Add new beauty essentials to your product collection.
                </p>
            </a>
        </div>

        <div class="col-12 col-md-6 col-xl-4">
            <a href="{{ path('app_profile') }}" class="ns-feature-card">
                <div class="ns-feature-icon">👤</div>
                <h3>My Profile</h3>
                <p>
                    View your account information and personal details.
                </p>
            </a>
        </div>

        <div class="col-12 col-md-6 col-xl-4">
            <a href="{{ path('app_change_password') }}" class="ns-feature-card">
                <div class="ns-feature-icon">🔐</div>
                <h3>Security & Password</h3>
                <p>
                    Keep your administrator account secure.
                </p>
            </a>
        </div>

        <div class="col-12 col-md-6 col-xl-4">
            <a href="{{ path('app_home') }}" class="ns-feature-card">
                <div class="ns-feature-icon">🏬</div>
                <h3>Visit Customer Store</h3>
                <p>
                    Preview the public NS COSMETIQ shopping website.
                </p>
            </a>
        </div>
    </div>

    <div class="ns-panel">
        <div class="ns-panel-header">
            <h2>✨ Recently Added Products</h2>
            <a href="{{ path('product_index') }}" class="ns-panel-link">
                View All Products
            </a>
        </div>

        {% for product in recentProducts %}
            <div class="ns-product-row">
                <div>
                    <strong>{{ product.name }}</strong>
                    <div>
                        <span>Product #{{ product.id }}</span>
                    </div>
                </div>
                <span>NS COSMETIQ</span>
            </div>
        {% else %}
            <div class="ns-empty">
                No products have been added yet.
                <div class="mt-3">
                    <a href="{{ path('product_new') }}" class="ns-action">
                        Add First Product
                    </a>
                </div>
            </div>
        {% endfor %}
    </div>

</div>
{% endblock %}
