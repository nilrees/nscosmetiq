
{% extends 'base.html.twig' %}

{% block title %}Admin Dashboard | NS COSMETIQ{% endblock %}

{% block stylesheets %}
    {{ parent() }}

    <style>
        .ns-dashboard {
            color: #49332D;
            padding: 20px 5px 50px;
        }

        .ns-dashboard-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
            flex-wrap: wrap;
            margin-bottom: 30px;
            padding-bottom: 22px;
            border-bottom: 1px solid #EBD7D0;
        }

        .ns-dashboard-header h1 {
            font-size: clamp(26px, 3vw, 36px);
            font-weight: 800;
            margin: 0 0 8px;
        }

        .ns-dashboard-header p {
            color: #92776D;
            margin: 0;
        }

        .ns-accent {
            color: #C0603F;
        }

        .ns-action {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 12px 20px;
            background: #C0603F;
            color: #FFFFFF;
            border-radius: 12px;
            text-decoration: none;
            font-weight: 700;
            transition: 0.2s;
            border: none;
        }

        .ns-action:hover {
            background: #9E492D;
            color: #FFFFFF;
            transform: translateY(-2px);
        }

        .ns-stat-card {
            background: #FFFFFF;
            border: 1px solid #F0DDD5;
            border-radius: 18px;
            padding: 25px;
            height: 100%;
            min-height: 155px;
            box-shadow: 0 8px 25px rgba(93, 57, 45, 0.045);
        }

        .ns-stat-icon {
            width: 48px;
            height: 48px;
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 23px;
            margin-bottom: 15px;
            background: #FBE8E1;
        }

        .ns-stat-icon.staff {
            background: #F4E7F0;
        }

        .ns-stat-icon.products {
            background: #F8EBD6;
        }

        .ns-stat-icon.stock {
            background: #E4F1E9;
        }

        .ns-stat-icon.low {
            background: #FFF0D6;
        }

        .ns-stat-icon.out {
            background: #FCE2E5;
        }

        .ns-stat-value {
            font-size: 35px;
            font-weight: 800;
            line-height: 1.2;
        }

        .ns-stat-label {
            color: #987A70;
            font-size: 13px;
            font-weight: 700;
            margin-top: 7px;
        }

        .ns-section-title {
            font-size: 22px;
            font-weight: 800;
            margin: 35px 0 20px;
        }

        .ns-feature-card {
            display: block;
            height: 100%;
            padding: 25px;
            background: #FFFFFF;
            border: 1px solid #F0DDD5;
            border-radius: 18px;
            text-decoration: none;
            color: #49332D;
            transition: 0.2s;
        }

        .ns-feature-card:hover {
            transform: translateY(-4px);
            border-color: #C0603F;
            box-shadow: 0 12px 30px rgba(93, 57, 45, 0.09);
            color: #49332D;
        }

        .ns-feature-icon {
            font-size: 30px;
            margin-bottom: 15px;
        }

        .ns-feature-card h3 {
            font-size: 18px;
            font-weight: 800;
        }

        .ns-feature-card p {
            color: #92776D;
            font-size: 13px;
            margin-bottom: 0;
        }

        .ns-panel {
            background: #FFFFFF;
            border: 1px solid #F0DDD5;
            border-radius: 18px;
            overflow: hidden;
            margin-top: 30px;
        }

        .ns-panel-header {
            padding: 20px 24px;
            border-bottom: 1px solid #F0DDD5;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 12px;
        }

        .ns-panel-header h2 {
            font-size: 19px;
            font-weight: 800;
            margin: 0;
        }

        .ns-panel-link {
            color: #C0603F;
            font-size: 13px;
            font-weight: 700;
            text-decoration: none;
        }

        .ns-product-row {
            padding: 15px 24px;
            border-bottom: 1px solid #F6EAE5;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 15px;
        }

        .ns-product-row:last-child {
            border-bottom: 0;
        }

        .ns-product-info {
            display: flex;
            align-items: center;
            gap: 14px;
            min-width: 0;
        }

        .ns-product-image {
            width: 55px;
            height: 55px;
            border-radius: 12px;
            object-fit: cover;
            border: 1px solid #F0DDD5;
            flex-shrink: 0;
        }

        .ns-image-placeholder {
            width: 55px;
            height: 55px;
            border-radius: 12px;
            background: #FBE8E1;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 25px;
            flex-shrink: 0;
        }

        .ns-product-row strong {
            font-size: 14px;
            display: block;
        }

        .ns-product-row span {
            font-size: 12px;
            color: #987A70;
        }

        .ns-product-price {
            font-weight: 800;
            color: #C0603F;
            white-space: nowrap;
        }

        .ns-empty {
            text-align: center;
            padding: 35px;
            color: #987A70;
        }

        @media (max-width: 768px) {
            .ns-dashboard {
                padding: 15px 0 35px;
            }

            .ns-dashboard-header {
                align-items: flex-start;
            }

            .ns-action {
                width: 100%;
            }

            .ns-stat-card {
                padding: 20px;
                min-height: 140px;
            }

            .ns-stat-value {
                font-size: 30px;
            }

            .ns-feature-card {
                padding: 20px;
            }

            .ns-product-row {
                padding: 15px;
            }
        }
    </style>
{% endblock %}

{% block body %}
<div class="ns-dashboard">

    <div class="ns-dashboard-header">
        <div>
            <h1>
                ✦ <span class="ns-accent">Beauty</span> Management
            </h1>

            <p>
                Welcome to NS COSMETIQ.
                Manage your beauty collection, staff, and store.
            </p>
        </div>

        <a href="{{ path('product_new') }}" class="ns-action">
            + Add New Product
        </a>
    </div>

    {# DASHBOARD STATISTICS #}
    <div class="row g-4">

        <div class="col-12 col-sm-6 col-xl-4">
            <div class="ns-stat-card">
                <div class="ns-stat-icon">👥</div>
                <div class="ns-stat-value">{{ totalUsers }}</div>
                <div class="ns-stat-label">TOTAL USERS</div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-4">
            <div class="ns-stat-card">
                <div class="ns-stat-icon staff">🪪</div>
                <div class="ns-stat-value">{{ totalStaff }}</div>
                <div class="ns-stat-label">TOTAL STAFF</div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-4">
            <div class="ns-stat-card">
                <div class="ns-stat-icon products">🛍️</div>
                <div class="ns-stat-value">{{ totalRecords }}</div>
                <div class="ns-stat-label">TOTAL PRODUCTS</div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-4">
            <div class="ns-stat-card">
                <div class="ns-stat-icon stock">📦</div>
                <div class="ns-stat-value">{{ totalStock }}</div>
                <div class="ns-stat-label">TOTAL STOCK UNITS</div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-4">
            <div class="ns-stat-card">
                <div class="ns-stat-icon low">⚠️</div>
                <div class="ns-stat-value">{{ lowStock }}</div>
                <div class="ns-stat-label">LOW STOCK PRODUCTS (1–5)</div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-4">
            <div class="ns-stat-card">
                <div class="ns-stat-icon out">🚫</div>
                <div class="ns-stat-value">{{ outOfStock }}</div>
                <div class="ns-stat-label">OUT OF STOCK PRODUCTS</div>
            </div>
        </div>

    </div>


{# ORDER STATISTICS #}
<h2 class="ns-section-title">Order Overview</h2>

<div class="row g-4">

    <div class="col-12 col-sm-6 col-xl-4">
        <div class="ns-stat-card">
            <div class="ns-stat-icon">📦</div>
            <div class="ns-stat-value">
                {{ totalOrders|default(0) }}
            </div>
            <div class="ns-stat-label">TOTAL ORDERS</div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-4">
        <div class="ns-stat-card">
            <div class="ns-stat-icon low">⏳</div>
            <div class="ns-stat-value">
                {{ pendingOrders|default(0) }}
            </div>
            <div class="ns-stat-label">PENDING ORDERS</div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-4">
        <div class="ns-stat-card">
            <div class="ns-stat-icon stock">🚚</div>
            <div class="ns-stat-value">
                {{ processingOrders|default(0) }}
            </div>
            <div class="ns-stat-label">PROCESSING ORDERS</div>
        </div>
    </div>

</div>

    {# MANAGEMENT LINKS #}
    <h2 class="ns-section-title">Store Management</h2>

    <div class="row g-4">


<div class="col-12 col-md-6 col-xl-4">
    <a href="{{ path('staff_orders') }}" class="ns-feature-card">
        <div class="ns-feature-icon">🛍️</div>
        <h3>Manage Orders</h3>
        <p>View customer orders and update delivery statuses.</p>
    </a>
</div>


        <div class="col-12 col-md-6 col-xl-4">
            <a href="{{ path('product_index') }}" class="ns-feature-card">
                <div class="ns-feature-icon">💄</div>
                <h3>Product Collection</h3>
                <p>View, add, update, and manage all products.</p>
            </a>
        </div>

        <div class="col-12 col-md-6 col-xl-4">
            <a href="{{ path('admin_user_index') }}" class="ns-feature-card">
                <div class="ns-feature-icon">👥</div>
                <h3>Users & Roles</h3>
                <p>Manage staff accounts, permissions, and access.</p>
            </a>
        </div>

        <div class="col-12 col-md-6 col-xl-4">
            <a href="{{ path('product_new') }}" class="ns-feature-card">
                <div class="ns-feature-icon">✨</div>
                <h3>Add New Product</h3>
                <p>Add beauty essentials to your collection.</p>
            </a>
        </div>

        <div class="col-12 col-md-6 col-xl-4">
            <a href="{{ path('app_profile') }}" class="ns-feature-card">
                <div class="ns-feature-icon">👤</div>
                <h3>My Profile</h3>
                <p>View and manage your account information.</p>
            </a>
        </div>

        <div class="col-12 col-md-6 col-xl-4">
            <a href="{{ path('app_change_password') }}" class="ns-feature-card">
                <div class="ns-feature-icon">🔐</div>
                <h3>Security & Password</h3>
                <p>Keep your administrator account secure.</p>
            </a>
        </div>

        <div class="col-12 col-md-6 col-xl-4">
            <a href="{{ path('app_home') }}" class="ns-feature-card">
                <div class="ns-feature-icon">🏬</div>
                <h3>Visit Customer Store</h3>
                <p>Preview the public NS COSMETIQ website.</p>
            </a>
        </div>

    </div>

    {# RECENT PRODUCTS #}
    <div class="ns-panel">

        <div class="ns-panel-header">
            <h2>✨ Recently Added Products</h2>

            <a href="{{ path('product_index') }}" class="ns-panel-link">
                View All Products
            </a>
        </div>

        {% for product in recentProducts %}

            <div class="ns-product-row">

                <div class="ns-product-info">

                    {% if product.imageFilename %}
                        <img
                            src="{{ asset('uploads/products/' ~ product.imageFilename) }}"
                            alt="{{ product.name }}"
                            class="ns-product-image"
                            loading="lazy"
                        >
                    {% else %}
                        <div class="ns-image-placeholder">💄</div>
                    {% endif %}

                    <div>
                        <strong>{{ product.name }}</strong>
                        <span>
                            {{ product.category }}
                            · Stock: {{ product.stock }}
                        </span>
                    </div>

                </div>

                <div class="ns-product-price">
                    ₱{{ product.price|number_format(2) }}
                </div>

            </div>

        {% else %}

            <div class="ns-empty">
                No products have been added yet.

                <div class="mt-3">
                    <a href="{{ path('product_new') }}" class="ns-action">
                        Add First Product
                    </a>
                </div>
            </div>

        {% endfor %}

    </div>

</div>
{% endblock %}
