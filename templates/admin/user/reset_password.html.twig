{% extends 'base.html.twig' %}

{% block title %}Reset Password{% endblock %}

{% block body %}
<div class="card mx-auto" style="max-width: 600px;">
    <div class="card-body">
        <h1 class="h4 mb-3">Reset password for {{ user.email }}</h1>
        {{ form_start(form) }}
            {{ form_widget(form) }}
            <button class="btn btn-warning">Reset password</button>
            <a href="{{ path('admin_user_index') }}" class="btn btn-secondary">Cancel</a>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}