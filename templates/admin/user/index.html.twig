
{% extends 'base.html.twig' %}

{% block title %}Users & Roles | NS COSMETIQ{% endblock %}

{% block stylesheets %}
<style>
    .ns-users-page {
        color: #49332D;
        font-family: 'Raleway', sans-serif;
    }

    .ns-users-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 20px;
        margin-bottom: 28px;
    }

    .ns-users-eyebrow {
        color: #C0603F;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 2px;
        text-transform: uppercase;
        margin-bottom: 8px;
    }

    .ns-users-header h1 {
        font-size: 32px;
        font-weight: 800;
        margin: 0 0 8px;
    }

    .ns-users-header p {
        color: #94786F;
        margin: 0;
        font-size: 14px;
    }

    .ns-users-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        padding: 11px 18px;
        border-radius: 10px;
        border: 1px solid transparent;
        font-size: 12px;
        font-weight: 700;
        text-decoration: none;
        cursor: pointer;
        transition: 0.2s ease;
        white-space: nowrap;
    }

    .ns-users-btn-primary {
        background: #C0603F;
        color: white;
    }

    .ns-users-btn-primary:hover {
        background: #A34E32;
        color: white;
    }

    .ns-users-btn-outline {
        background: white;
        border-color: #E9C6B8;
        color: #49332D;
    }

    .ns-users-btn-outline:hover {
        background: #FFF0E9;
        color: #49332D;
    }

    .ns-users-btn-danger {
        background: #FFF1F1;
        color: #B23F4B;
        border-color: #F0C7CB;
    }

    .ns-users-btn-danger:hover {
        background: #B23F4B;
        color: white;
    }

    .ns-users-btn:disabled {
        opacity: 0.55;
        cursor: not-allowed;
    }

    .ns-users-stats {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 18px;
        margin-bottom: 26px;
    }

    .ns-users-stat {
        background: white;
        border: 1px solid #F0DDD5;
        border-radius: 18px;
        padding: 22px;
    }

    .ns-users-stat-label {
        color: #94786F;
        font-size: 12px;
        font-weight: 700;
        margin-bottom: 10px;
    }

    .ns-users-stat-number {
        font-size: 32px;
        font-weight: 800;
        line-height: 1;
    }

    .ns-users-panel {
        background: white;
        border: 1px solid #F0DDD5;
        border-radius: 18px;
        overflow: hidden;
        margin-bottom: 26px;
    }

    .ns-users-panel-heading {
        padding: 22px 24px;
        border-bottom: 1px solid #F2E4DE;
    }

    .ns-users-panel-heading h2 {
        font-size: 19px;
        font-weight: 800;
        margin: 0 0 6px;
    }

    .ns-users-panel-heading p {
        font-size: 13px;
        color: #94786F;
        margin: 0;
    }

    .ns-users-table {
        width: 100%;
        border-collapse: collapse;
        margin: 0;
    }

    .ns-users-table thead {
        background: #F9EDE7;
    }

    .ns-users-table th {
        padding: 15px 18px;
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 0.8px;
        color: #76584F;
        white-space: nowrap;
    }

    .ns-users-table td {
        padding: 18px;
        border-top: 1px solid #F3E7E1;
        font-size: 13px;
        vertical-align: middle;
    }

    .ns-users-table tbody tr:hover {
        background: #FFFBF9;
    }

    .ns-users-name {
        font-weight: 800;
        color: #49332D;
    }

    .ns-users-email {
        color: #94786F;
        font-size: 12px;
        margin-top: 4px;
    }

    .ns-users-badge {
        display: inline-flex;
        align-items: center;
        border-radius: 20px;
        padding: 7px 12px;
        font-size: 11px;
        font-weight: 800;
    }

    .ns-role-admin {
        color: #9A4C32;
        background: #FCE7DE;
    }

    .ns-role-staff {
        color: #65518C;
        background: #F0EAFB;
    }

    .ns-status-active {
        color: #26724A;
        background: #E6F6EB;
    }

    .ns-status-disabled {
        color: #777;
        background: #EEEEEE;
    }

    .ns-users-role-form {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
    }

    .ns-users-select {
        min-width: 115px;
        padding: 9px 10px;
        border: 1px solid #E9C6B8;
        border-radius: 9px;
        color: #49332D;
        background: #FFFDFB;
        font-size: 12px;
    }

    .ns-users-select:focus {
        outline: 2px solid #E9B6A5;
    }

    .ns-users-save {
        padding: 9px 12px;
        background: #C0603F;
        color: white;
        border: none;
        border-radius: 9px;
        font-size: 12px;
        font-weight: 700;
    }

    .ns-users-save:hover {
        background: #A34E32;
    }

    .ns-users-actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 7px;
    }

    .ns-users-actions form {
        margin: 0;
    }

    .ns-users-actions .ns-users-btn {
        padding: 8px 11px;
        font-size: 11px;
    }

    .ns-permissions-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 18px;
        padding: 22px;
    }

    .ns-permission-card {
        border: 1px solid #F0DDD5;
        background: #FFFCFA;
        border-radius: 15px;
        padding: 22px;
    }

    .ns-permission-card h3 {
        font-size: 17px;
        font-weight: 800;
        margin-bottom: 14px;
    }

    .ns-permission-card ul {
        padding-left: 20px;
        margin: 0;
    }

    .ns-permission-card li {
        font-size: 13px;
        line-height: 2;
        color: #76584F;
    }

    .ns-users-note {
        color: #94786F;
        font-size: 12px;
        margin-top: 10px;
    }

    @media (max-width: 900px) {
        .ns-users-stats {
            grid-template-columns: 1fr;
        }

        .ns-permissions-grid {
            grid-template-columns: 1fr;
        }
    }

    @media (max-width: 600px) {
        .ns-users-header h1 {
            font-size: 26px;
        }

        .ns-users-panel-heading {
            padding: 18px;
        }
    }
</style>
{% endblock %}

{% block body %}

{% set totalAdmins = 0 %}
{% set totalStaff = 0 %}
{% set totalActive = 0 %}

{% for account in users %}
    {% if 'ROLE_ADMIN' in account.roles %}
        {% set totalAdmins = totalAdmins + 1 %}
    {% elseif 'ROLE_STAFF' in account.roles %}
        {% set totalStaff = totalStaff + 1 %}
    {% endif %}

    {% if account.isActive %}
        {% set totalActive = totalActive + 1 %}
    {% endif %}
{% endfor %}

<div class="ns-users-page">

    {# PAGE HEADER #}
    <div class="ns-users-header">
        <div>
            <div class="ns-users-eyebrow">
                ADMINISTRATION / ACCESS CONTROL
            </div>

            <h1>Users & Roles</h1>

            <p>
                Manage staff accounts, assign roles,
                and control access to NS COSMETIQ.
            </p>
        </div>

        <a
            href="{{ path('admin_user_new') }}"
            class="ns-users-btn ns-users-btn-primary"
        >
            + Add New User
        </a>
    </div>

    {# ACCOUNT STATISTICS #}
    <div class="ns-users-stats">

        <div class="ns-users-stat">
            <div class="ns-users-stat-label">Total Accounts</div>
            <div class="ns-users-stat-number">
                {{ users|length }}
            </div>
        </div>

        <div class="ns-users-stat">
            <div class="ns-users-stat-label">Administrators</div>
            <div class="ns-users-stat-number">
                {{ totalAdmins }}
            </div>
        </div>

        <div class="ns-users-stat">
            <div class="ns-users-stat-label">Staff Members</div>
            <div class="ns-users-stat-number">
                {{ totalStaff }}
            </div>
        </div>

    </div>

    {# USERS TABLE #}
    <div class="ns-users-panel">

        <div class="ns-users-panel-heading">
            <h2>Account Directory</h2>

            <p>
                {{ totalActive }} active account(s).
                Change roles or manage account access below.
            </p>
        </div>

        <div class="table-responsive">

            <table class="ns-users-table">
                <thead>
                    <tr>
                        <th>User</th>
                        <th>Current Role</th>
                        <th>Assign Role</th>
                        <th>Permissions</th>
                        <th>Status</th>
                        <th>Created</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                {% for user in users %}

                    {% set isAdmin = 'ROLE_ADMIN' in user.roles %}
                    {% set isSelf = user.id == app.user.id %}

                    <tr>

                        {# USER INFORMATION #}
                        <td>
                            <div class="ns-users-name">
                                {{ user.fullName }}
                                {% if isSelf %}
                                    <span class="text-muted">(You)</span>
                                {% endif %}
                            </div>

                            <div class="ns-users-email">
                                {{ user.email }}
                            </div>
                        </td>

                        {# CURRENT ROLE #}
                        <td>
                            {% if isAdmin %}
                                <span class="ns-users-badge ns-role-admin">
                                    Administrator
                                </span>
                            {% elseif 'ROLE_STAFF' in user.roles %}
                                <span class="ns-users-badge ns-role-staff">
                                    Staff
                                </span>
                            {% else %}
                                <span class="ns-users-badge ns-status-disabled">
                                    No assigned role
                                </span>
                            {% endif %}
                        </td>

                        {# CHANGE ROLE #}
                        <td>
                            {% if not isSelf %}

                                <form
                                    method="post"
                                    action="{{ path('admin_user_role', {id: user.id}) }}"
                                    class="ns-users-role-form"
                                    onsubmit="return confirm('Update this user role?');"
                                >

                                    <input
                                        type="hidden"
                                        name="_token"
                                        value="{{ csrf_token('change-role-' ~ user.id) }}"
                                    >

                                    <select
                                        name="role"
                                        class="ns-users-select"
                                        aria-label="Select role for {{ user.fullName }}"
                                    >
                                        <option
                                            value="ROLE_ADMIN"
                                            {% if isAdmin %}selected{% endif %}
                                        >
                                            Admin
                                        </option>

                                        <option
                                            value="ROLE_STAFF"
                                            {% if not isAdmin %}selected{% endif %}
                                        >
                                            Staff
                                        </option>
                                    </select>

                                    <button
                                        type="submit"
                                        class="ns-users-save"
                                    >
                                        Save
                                    </button>

                                </form>

                            {% else %}
                                <span class="text-muted">
                                    Your account
                                </span>
                            {% endif %}
                        </td>

                        {# PERMISSIONS #}
                        <td>
                            {% if isAdmin %}
                                <strong>Full access</strong>
                                <div class="ns-users-email">
                                    Users + all products
                                </div>
                            {% elseif 'ROLE_STAFF' in user.roles %}
                                <strong>Limited access</strong>
                                <div class="ns-users-email">
                                    Own products only
                                </div>
                            {% else %}
                                <span class="text-muted">
                                    No management access
                                </span>
                            {% endif %}
                        </td>

                        {# ACCOUNT STATUS #}
                        <td>
                            {% if user.isActive %}
                                <span class="ns-users-badge ns-status-active">
                                    Active
                                </span>
                            {% else %}
                                <span class="ns-users-badge ns-status-disabled">
                                    Disabled
                                </span>
                            {% endif %}
                        </td>

                        {# CREATED DATE #}
                        <td>
                            {{ user.createdAt|date('M d, Y') }}
                        </td>

                        {# ACTION BUTTONS #}
                        <td>
                            <div class="ns-users-actions">

                                <a
                                    href="{{ path('admin_user_edit', {id: user.id}) }}"
                                    class="ns-users-btn ns-users-btn-outline"
                                >
                                    Edit
                                </a>

                                <a
                                    href="{{ path('admin_user_reset_password', {id: user.id}) }}"
                                    class="ns-users-btn ns-users-btn-outline"
                                >
                                    Reset PW
                                </a>

                                {% if not isSelf %}

                                    <form
                                        method="post"
                                        action="{{ path('admin_user_toggle', {id: user.id}) }}"
                                        onsubmit="return confirm('Change this account status?');"
                                    >
                                        <input
                                            type="hidden"
                                            name="_token"
                                            value="{{ csrf_token('toggle' ~ user.id) }}"
                                        >

                                        <button
                                            type="submit"
                                            class="ns-users-btn ns-users-btn-outline"
                                        >
                                            {{ user.isActive ? 'Disable' : 'Enable' }}
                                        </button>
                                    </form>

                                    <form
                                        method="post"
                                        action="{{ path('admin_user_delete', {id: user.id}) }}"
                                        onsubmit="return confirm('Permanently delete this user?');"
                                    >
                                        <input
                                            type="hidden"
                                            name="_token"
                                            value="{{ csrf_token('delete' ~ user.id) }}"
                                        >

                                        <button
                                            type="submit"
                                            class="ns-users-btn ns-users-btn-danger"
                                        >
                                            Delete
                                        </button>
                                    </form>

                                {% endif %}

                            </div>
                        </td>

                    </tr>

                {% else %}

                    <tr>
                        <td colspan="7" class="text-center py-5">
                            No user accounts found.
                        </td>
                    </tr>

                {% endfor %}
                </tbody>
            </table>

        </div>
    </div>

    {# ROLE PERMISSION REFERENCE #}
    <div class="ns-users-panel">

        <div class="ns-users-panel-heading">
            <h2>Role Permissions</h2>
            <p>
                Overview of what each NS COSMETIQ role is allowed to do.
            </p>
        </div>

        <div class="ns-permissions-grid">

            <div class="ns-permission-card">

                <h3>
                    <span class="ns-users-badge ns-role-admin">
                        ADMIN
                    </span>
                </h3>

                <ul>
                    <li>Access the Admin Dashboard</li>
                    <li>View all user accounts</li>
                    <li>Create and edit user accounts</li>
                    <li>Assign Admin and Staff roles</li>
                    <li>Enable and disable accounts</li>
                    <li>Reset user passwords</li>
                    <li>Manage all products</li>
                    <li>View product and user statistics</li>
                </ul>

            </div>

            <div class="ns-permission-card">

                <h3>
                    <span class="ns-users-badge ns-role-staff">
                        STAFF
                    </span>
                </h3>

                <ul>
                    <li>Access the Staff Dashboard</li>
                    <li>View the product directory</li>
                    <li>Add new products</li>
                    <li>Edit products they created</li>
                    <li>Delete products they created</li>
                    <li>Manage their own profile</li>
                    <li>Change their own password</li>
                    <li>Cannot manage users or assign roles</li>
                </ul>

            </div>

        </div>
    </div>

    <p class="ns-users-note">
        Security note: Role changes are restricted to administrators.
        You cannot change your own role or disable/delete your own account.
    </p>

</div>

{% endblock %}
