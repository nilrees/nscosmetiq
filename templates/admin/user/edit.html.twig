{% extends 'base.html.twig' %}

{% block title %}Edit User{% endblock %}

{% block body %}
<div class="card mx-auto" style="max-width: 600px;">
    <div class="card-body">
        <h1 class="h4 mb-3">Edit User</h1>
        {% if isSelf %}
            <div class="alert alert-info">You are editing your own account, so role and status are locked.</div>
        {% endif %}
        {{ form_start(form) }}
            {{ form_widget(form) }}
            <button class="btn btn-primary">Save changes</button>
            <a href="{{ path('admin_user_index') }}" class="btn btn-secondary">Cancel</a>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}