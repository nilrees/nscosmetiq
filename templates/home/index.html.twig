
{% extends 'base.html.twig' %}

{% block title %}NS COSMETIQ | Discover Your Best Skin{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
    .ns-store {
        --cream: #FFF8F5;
        --blush: #F9E3DC;
        --rose: #C0603F;
        --brown: #49332D;
        --muted: #8A7169;
        color: var(--brown);
        background: #fffdfb;
        font-family: 'Raleway', sans-serif;
    }

    .ns-store * {
        box-sizing: border-box;
    }

    .ns-store a {
        text-decoration: none;
    }

    .ns-announcement {
        background: var(--brown);
        color: white;
        padding: 10px 20px;
        text-align: center;
        font-size: 11px;
        letter-spacing: 2px;
        font-weight: 700;
    }

    .ns-navbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 23px 6%;
        gap: 20px;
        background: #fff;
        border-bottom: 1px solid #f3e7e2;
        flex-wrap: wrap;
    }

    .ns-logo {
        font-size: 25px;
        font-weight: 900;
        letter-spacing: 2px;
        color: var(--brown);
        white-space: nowrap;
    }

    .ns-logo span {
        color: var(--rose);
    }

    .ns-nav-links {
        display: flex;
        gap: 23px;
        align-items: center;
        flex-wrap: wrap;
    }

    .ns-nav-links a {
        color: var(--brown);
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 1px;
        transition: color .2s;
    }

    .ns-nav-links a:hover {
        color: var(--rose);
    }

    .ns-account-link {
        background: var(--blush);
        border-radius: 30px;
        padding: 11px 18px;
    }

    .ns-hero {
        min-height: 540px;
        display: grid;
        grid-template-columns: 1fr 1fr;
        align-items: center;
        background: linear-gradient(115deg, #fff8f5, #f9e3dc);
        overflow: hidden;
    }

    .ns-hero-copy {
        padding: 75px 7% 75px 12%;
    }

    .ns-eyebrow {
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 3px;
        color: var(--rose);
        text-transform: uppercase;
        margin-bottom: 20px;
    }

    .ns-hero h1 {
        font-family: Georgia, serif;
        font-size: clamp(42px, 5vw, 76px);
        line-height: 1.12;
        font-weight: 500;
        letter-spacing: -2px;
        margin-bottom: 25px;
    }

    .ns-hero h1 em {
        color: var(--rose);
        font-weight: 400;
    }

    .ns-hero p {
        color: #80665c;
        line-height: 1.9;
        font-size: 15px;
        max-width: 470px;
        margin-bottom: 30px;
    }

    .ns-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: var(--brown);
        color: white;
        border: 1px solid var(--brown);
        border-radius: 30px;
        padding: 15px 30px;
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 1px;
        transition: all .2s;
        cursor: pointer;
    }

    .ns-button:hover {
        background: var(--rose);
        border-color: var(--rose);
        color: white;
        transform: translateY(-2px);
    }

    .ns-hero-art {
        min-height: 540px;
        background: radial-gradient(circle at 55% 45%, #fcece5 0%, #efc6b6 65%, #e8b6a4 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 45px;
        position: relative;
        overflow: hidden;
    }

    .ns-hero-circle {
        width: min(420px, 80%);
        aspect-ratio: 1;
        border-radius: 50%;
        background: rgba(255,255,255,.35);
        border: 1px solid rgba(255,255,255,.6);
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 25px 80px rgba(124,62,46,.10);
    }

    .ns-hero-mark {
        text-align: center;
        color: #a34f39;
    }

    .ns-hero-mark strong {
        display: block;
        font-family: Georgia, serif;
        font-size: clamp(50px, 7vw, 105px);
        font-weight: 400;
        letter-spacing: -7px;
    }

    .ns-hero-mark span {
        display: block;
        font-size: 12px;
        letter-spacing: 6px;
        font-weight: 800;
    }

    .ns-trust-bar {
        display: flex;
        justify-content: center;
        gap: 50px;
        flex-wrap: wrap;
        background: #fff;
        padding: 24px 6%;
        border-bottom: 1px solid #f2e6e1;
    }

    .ns-trust-bar span {
        font-size: 12px;
        letter-spacing: 1px;
        font-weight: 700;
        color: #80665c;
    }

    .ns-section {
        padding: 85px 7%;
    }

    .ns-section-soft {
        background: var(--cream);
    }

    .ns-section-heading {
        text-align: center;
        margin-bottom: 45px;
    }

    .ns-section-heading h2 {
        font-family: Georgia, serif;
        font-weight: 400;
        font-size: clamp(30px, 4vw, 44px);
        margin-bottom: 12px;
    }

    .ns-section-heading p {
        color: var(--muted);
        font-size: 14px;
        line-height: 1.8;
    }

    .ns-category-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 22px;
    }

    .ns-category-card {
        min-height: 235px;
        background: linear-gradient(145deg, #fbe7df, #f1cbbd);
        border-radius: 18px;
        padding: 35px;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        position: relative;
        overflow: hidden;
        transition: transform .25s;
    }

    .ns-category-card:nth-child(2) {
        background: linear-gradient(145deg, #f8efe7, #e9d5c7);
    }

    .ns-category-card:nth-child(3) {
        background: linear-gradient(145deg, #f7dedc, #e9bdba);
    }

    .ns-category-card:hover {
        transform: translateY(-5px);
    }

    .ns-category-card::before {
        content: '';
        position: absolute;
        width: 190px;
        height: 190px;
        border: 1px solid rgba(255,255,255,.65);
        border-radius: 50%;
        top: -75px;
        right: -45px;
        box-shadow: 0 0 0 25px rgba(255,255,255,.12);
    }

    .ns-category-card h3 {
        position: relative;
        font-family: Georgia, serif;
        font-size: 29px;
        color: var(--brown);
    }

    .ns-category-card p {
        position: relative;
        color: #795b51;
        font-size: 12px;
        font-weight: 700;
        margin-bottom: 0;
    }

    .ns-shop-tools {
        max-width: 900px;
        margin: 0 auto 35px;
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
    }

    .ns-shop-tools input,
    .ns-shop-tools select {
        padding: 14px 17px;
        border: 1px solid #e7d7d0;
        border-radius: 12px;
        background: white;
        color: var(--brown);
        outline: none;
        min-width: 0;
    }

    .ns-shop-tools input {
        flex: 2;
    }

    .ns-shop-tools select {
        flex: 1;
    }

    .ns-shop-tools input:focus,
    .ns-shop-tools select:focus {
        border-color: var(--rose);
    }

    .ns-product-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 28px;
    }

    .ns-product-card {
        background: white;
        border: 1px solid #f0e5e0;
        border-radius: 18px;
        overflow: hidden;
        transition: transform .25s, box-shadow .25s;
    }

    .ns-product-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 15px 35px rgba(73,51,45,.08);
    }

    .ns-product-photo {
        height: 280px;
        background: #f8eae5;
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }

    .ns-product-photo img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform .35s;
    }

    .ns-product-card:hover .ns-product-photo img {
        transform: scale(1.05);
    }

    .ns-product-placeholder {
        font-family: Georgia, serif;
        font-size: 55px;
        font-style: italic;
        color: #d0a395;
        opacity: .8;
    }

    .ns-product-badge {
        position: absolute;
        top: 16px;
        left: 16px;
        background: white;
        border-radius: 20px;
        padding: 7px 13px;
        color: var(--brown);
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 1px;
    }

    .ns-product-info {
        padding: 23px;
    }

    .ns-product-category {
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 2px;
        color: var(--rose);
        text-transform: uppercase;
        margin-bottom: 10px;
    }

    .ns-product-info h3 {
        font-size: 17px;
        font-weight: 800;
        margin-bottom: 10px;
    }

    .ns-product-description {
        font-size: 12px;
        color: var(--muted);
        line-height: 1.7;
        min-height: 42px;
    }

    .ns-product-bottom {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        margin-top: 20px;
    }

    .ns-price {
        color: var(--rose);
        font-size: 19px;
        font-weight: 800;
    }

    .ns-stock-label {
        font-size: 11px;
        font-weight: 700;
        color: #56806b;
    }

    .ns-stock-label.out {
        color: #b34a55;
    }

    .ns-empty {
        text-align: center;
        padding: 60px 20px;
        background: #fff8f5;
        border-radius: 18px;
        color: var(--muted);
    }

    .ns-promo {
        background: linear-gradient(115deg, #49332d, #895744);
        color: white;
        text-align: center;
        padding: 85px 20px;
    }

    .ns-promo h2 {
        font-family: Georgia, serif;
        font-size: clamp(32px, 4vw, 50px);
        font-weight: 400;
        margin-bottom: 18px;
    }

    .ns-promo p {
        max-width: 600px;
        margin: 0 auto 25px;
        line-height: 1.9;
        color: #f1dcd3;
    }

    .ns-promo .ns-button {
        background: #fff8f5;
        border-color: #fff8f5;
        color: #49332d;
    }

    .ns-new-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 20px;
    }

    .ns-new-item {
        border: 1px solid #f0e5e0;
        border-radius: 15px;
        overflow: hidden;
        background: white;
    }

    .ns-new-photo {
        height: 190px;
        background: #f7e8e1;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .ns-new-photo img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .ns-new-info {
        padding: 17px;
    }

    .ns-new-info h3 {
        font-size: 13px;
        font-weight: 800;
        margin-bottom: 8px;
    }

    .ns-new-info strong {
        color: var(--rose);
        font-size: 14px;
    }

    .ns-about {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 60px;
        align-items: center;
    }
    

    .ns-about-art span {
        font-family: Georgia, serif;
        font-size: 100px;
        color: rgba(120,58,43,.55);
    }

    .ns-about-copy h2 {
        font-family: Georgia, serif;
        font-size: 42px;
        font-weight: 400;
        margin-bottom: 20px;
    }

    .ns-about-copy p {
        color: var(--muted);
        line-height: 2;
        font-size: 14px;
    }

    .ns-footer {
        background: #49332d;
        color: white;
        padding: 60px 7% 25px;
    }

    .ns-footer-grid {
        display: grid;
        grid-template-columns: 2fr 1fr 1fr;
        gap: 45px;
        margin-bottom: 45px;
    }

    .ns-footer h3 {
        font-size: 22px;
        font-weight: 900;
        letter-spacing: 2px;
    }

    .ns-footer h4 {
        font-size: 13px;
        font-weight: 800;
        margin-bottom: 18px;
    }

    .ns-footer p,
    .ns-footer a {
        font-size: 12px;
        color: #ead7cf;
        line-height: 2;
    }

    .ns-footer a {
        display: block;
    }

    .ns-footer-bottom {
        border-top: 1px solid rgba(255,255,255,.18);
        padding-top: 20px;
        text-align: center;
        font-size: 11px;
        color: #ead7cf;
    }

    @media (max-width: 1000px) {
        .ns-hero {
            grid-template-columns: 1fr;
        }

        .ns-hero-copy {
            padding: 65px 8%;
        }

        .ns-hero-art {
            min-height: 320px;
        }

        .ns-product-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .ns-new-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @media (max-width: 650px) {
        .ns-navbar {
            justify-content: center;
        }

        .ns-nav-links {
            justify-content: center;
            gap: 15px;
        }

        .ns-category-grid,
        .ns-product-grid,
        .ns-new-grid,
        .ns-about,
        .ns-footer-grid {
            grid-template-columns: 1fr;
        }

        .ns-section {
            padding: 60px 5%;
        }

        .ns-shop-tools {
            flex-direction: column;
        }

        .ns-hero h1 {
            font-size: 44px;
        }

        .ns-trust-bar {
            gap: 18px;
        }
    }

    /* NS COSMETIQ Logo */
.ns-brand-logo {
    width: auto;
    height: 75px;
    max-width: 190px;
    object-fit: contain;
    display: block;
}

/* Homepage Beauty Model */
.ns-model-hero {
    padding: 0;
    background: #F9E3DC;
    overflow: hidden;
}

.ns-model-image {
    width: 100%;
    height: 100%;
    min-height: 540px;
    object-fit: cover;
    object-position: center 25%;
    display: block;
}

@media (max-width: 768px) {
    .ns-brand-logo {
        height: 60px;
    }

    .ns-model-image {
        min-height: 350px;
        max-height: 450px;
    }
}


/* FIX: HOMEPAGE SECTIONS STACK VERTICALLY */

.ns-store {
    display: block !important;
    width: 100% !important;
    max-width: 100% !important;
    min-width: 0 !important;
    overflow-x: clip;
}

.ns-store > .ns-announcement,
.ns-store > .ns-navbar,
.ns-store > .ns-hero,
.ns-store > .ns-trust-bar,
.ns-store > .ns-section,
.ns-store > .ns-promo,
.ns-store > .ns-footer {
    width: 100% !important;
    max-width: 100% !important;
    flex: none !important;
    float: none !important;
    clear: both;
}

.ns-store > .ns-section,
.ns-store > .ns-promo,
.ns-store > .ns-footer {
    display: block;
}

.ns-store > .ns-about {
    display: grid;
}

.ns-store .ns-product-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
}

.ns-store .ns-category-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
}

.ns-store .ns-new-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
}

@media (max-width: 1000px) {
    .ns-store .ns-product-grid,
    .ns-store .ns-new-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}

@media (max-width: 650px) {
    .ns-store .ns-product-grid,
    .ns-store .ns-category-grid,
    .ns-store .ns-new-grid,
    .ns-store > .ns-about {
        grid-template-columns: 1fr;
    }
}

/* ABOUT US IMAGE */
.ns-about-art {
    width: 100%;
    height: 405px;
    padding: 0 !important;
    overflow: hidden;
    border-radius: 22px;
    background: #F9E3DC;
}

.ns-about-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
}

/* DISCOVER PRODUCTS BUTTON */
.ns-store .ns-about-button {
    display: inline-block;
    margin-top: 15px;
    padding: 15px 30px;
    background: #C0603F !important;
    color: #FFFFFF !important;
    border-radius: 30px;
    text-decoration: none;
    font-weight: 700;
}

.ns-store .ns-about-button:hover {
    background: #49332D !important;
    color: #FFFFFF !important;
}

@media (max-width: 768px) {
    .ns-about-art {
        height: 300px;
    }
}


    /* Homepage Add to Cart buttons */
    .ns-cart-form { margin-top: 16px; }
    .ns-cart-button {
        width: 100%; display: flex; align-items: center; justify-content: center;
        gap: 8px; padding: 12px 16px; border: 1px solid #C0603F;
        border-radius: 12px; background: #C0603F; color: #fff;
        font-family: inherit; font-size: 12px; font-weight: 800;
        letter-spacing: .5px; cursor: pointer; transition: background .2s, transform .2s;
    }
    .ns-cart-button:hover:not(:disabled) { background: #9E492D; transform: translateY(-2px); }
    .ns-cart-button:disabled { background: #E9DCD6; border-color: #E9DCD6; color: #987A70; cursor: not-allowed; }
    .ns-new-info .ns-cart-form { margin-top: 12px; }
    .ns-new-info .ns-cart-button { font-size: 11px; padding: 10px; }
    .ns-cart-nav { white-space: nowrap; }

</style>
{% endblock %}

{% block body %}
<div class="ns-store">

    {# ANNOUNCEMENT BAR #}
    <div class="ns-announcement">
        NS COSMETIQ — BEAUTY BEGINS WITH YOU
    </div>

    {# NAVIGATION #}
    <nav class="ns-navbar">
        <a href="{{ path('app_home') }}" class="ns-logo">
    <img
        src="{{ asset('images/logo.png') }}"
        alt="NS COSMETIQ Logo"
        class="ns-brand-logo"
    >
</a>

        <div class="ns-nav-links">
            <a href="#home">HOME</a>
            <a href="#products">ALL PRODUCTS</a>
            <a href="#categories">CATEGORIES</a>
            <a href="#offers">SPECIAL OFFERS</a>
            <a href="#new">WHAT'S NEW</a>
            <a href="#about">ABOUT US</a>
        </div>

        <div class="ns-nav-links">
            <a href="{{ path('cart_index') }}" class="ns-cart-nav">🛒 CART</a>
            {% if app.user %}
                {% if is_granted('ROLE_ADMIN') %}
                    <a href="{{ path('admin_dashboard') }}" class="ns-account-link">
                        DASHBOARD
                    </a>
                {% elseif is_granted('ROLE_STAFF') %}
                    <a href="{{ path('staff_dashboard') }}" class="ns-account-link">
                        DASHBOARD
                    </a>
                {% endif %}

                <a href="{{ path('app_logout') }}">LOGOUT</a>
            {% else %}
                <a href="{{ path('app_login') }}" class="ns-account-link">
                    LOGIN
                </a>
            {% endif %}
        </div>
    </nav>

    {# HERO SECTION #}
    <section class="ns-hero" id="home">
        <div class="ns-hero-copy">
            <div class="ns-eyebrow">
                THE ART OF EVERYDAY BEAUTY
            </div>

            <h1>
                Discover Your
                <em>Best Skin</em>
                Ever.
            </h1>

            <p>
                Beauty is personal, and so are you.
                Explore our collection of skincare and
                makeup essentials made to celebrate
                your natural beauty and confidence.
            </p>

            <a href="#products" class="ns-button">
                EXPLORE COLLECTION
            </a>
        </div>

        <div class="ns-hero-art ns-model-hero">
            <img
                src="{{ asset('images/modelf.jpg') }}"
                alt="NS COSMETIQ Beauty Model"
                class="ns-model-image"
            >
        </div>
    </section>

    {# TRUST STRIP #}
    <div class="ns-trust-bar">
        <span>✦ BEAUTY ESSENTIALS</span>
        <span>✦ MAKEUP & SKINCARE</span>
        <span>✦ MADE FOR YOUR EVERYDAY GLOW</span>
    </div>

    {# CATEGORIES #}
    <section class="ns-section ns-section-soft" id="categories">
        <div class="ns-section-heading">
            <div class="ns-eyebrow">FIND YOUR FAVORITES</div>
            <h2>Shop by Category</h2>
            <p>Discover products that match your beauty routine.</p>
        </div>

        <div class="ns-category-grid">
            {% for item in categories|slice(0, 3) %}
                <a href="#products"
                   class="ns-category-card"
                   data-category-link="{{ item|lower|e('html_attr') }}">
                    <h3>{{ item|title }}</h3>
                    <p>EXPLORE COLLECTION →</p>
                </a>
            {% else %}
                <div class="ns-category-card">
                    <h3>Makeup</h3>
                    <p>EXPLORE BEAUTY</p>
                </div>
                <div class="ns-category-card">
                    <h3>Skincare</h3>
                    <p>DAILY ESSENTIALS</p>
                </div>
                <div class="ns-category-card">
                    <h3>Lip Products</h3>
                    <p>YOUR PERFECT SHADE</p>
                </div>
            {% endfor %}
        </div>
    </section>

    {# PRODUCTS #}
    <section class="ns-section" id="products">
        <div class="ns-section-heading">
            <div class="ns-eyebrow">THE BEAUTY EDIT</div>
            <h2>Explore Our Products</h2>
            <p>Find your new favorites from our NS COSMETIQ collection.</p>
        </div>

        <div class="ns-shop-tools">
            <input
                type="search"
                id="nsProductSearch"
                placeholder="Search products by name..."
                aria-label="Search products"
            >

            <select id="nsCategoryFilter" aria-label="Filter by category">
                <option value="">All Categories</option>
                {% for item in categories %}
                    <option value="{{ item|lower }}">
                        {{ item|title }}
                    </option>
                {% endfor %}
            </select>
        </div>

        <div class="ns-product-grid" id="nsProductGrid">
            {% for product in products %}
                <article
                    class="ns-product-card"
                    data-name="{{ product.name|lower|e('html_attr') }}"
                    data-category="{{ product.category|lower|e('html_attr') }}"
                >
                    <div class="ns-product-photo">
                        {% if product.imageFilename %}
                            <img
                                src="{{ asset('uploads/products/' ~ product.imageFilename) }}"
                                alt="{{ product.name }}"
                                loading="lazy"
                            >
                        {% else %}
                            <div class="ns-product-placeholder">NS</div>
                        {% endif %}

                        <span class="ns-product-badge">
                            {{ product.category|upper }}
                        </span>
                    </div>

                    <div class="ns-product-info">
                        <div class="ns-product-category">
                            {{ product.category }}
                        </div>

                        <h3>{{ product.name }}</h3>

                        <p class="ns-product-description">
                            {{ product.description|default('Discover this beauty essential from NS COSMETIQ.')|slice(0, 95) }}
                        </p>

                        <div class="ns-product-bottom">
                            <span class="ns-price">
                                ₱{{ product.price|number_format(2) }}
                            </span>

                            {% if product.stock > 0 %}
                                <span class="ns-stock-label">
                                    IN STOCK
                                </span>
                            {% else %}
                                <span class="ns-stock-label out">
                                    SOLD OUT
                                </span>
                            {% endif %}
                        </div>
                        {# Existing CartController handles CSRF and stock checks. #}
                        {% if product.stock > 0 %}
                            <form method="post" action="{{ path('cart_add', {id: product.id}) }}" class="ns-cart-form">
                                <input type="hidden" name="_token" value="{{ csrf_token('cart_add_' ~ product.id) }}">
                                <button type="submit" class="ns-cart-button">🛒 Add to Cart</button>
                            </form>
                        {% else %}
                            <div class="ns-cart-form"><button type="button" class="ns-cart-button" disabled>Out of Stock</button></div>
                        {% endif %}
                    </div>
                </article>
            {% else %}
                <div class="ns-empty">
                    <h3>Our beauty collection is coming soon.</h3>
                    <p>Check back for new NS COSMETIQ products.</p>
                </div>
            {% endfor %}
        </div>

        <div id="nsNoResults" class="ns-empty mt-4" style="display:none;">
            No products match your search. Try another name or category.
        </div>
    </section>

    {# SPECIAL OFFERS #}
    <section class="ns-promo" id="offers">
        <div class="ns-eyebrow" style="color:#f3c8b9;">
            A LITTLE EXTRA BEAUTY
        </div>

        <h2>Your Glow, Your Way.</h2>

        <p>
            Explore your favorite NS COSMETIQ beauty essentials.
            From everyday skincare to makeup must-haves,
            discover something special for your routine.
        </p>

        <a href="#products" class="ns-button">
            SHOP THE COLLECTION
        </a>
    </section>

    {# NEW ARRIVALS #}
    <section class="ns-section ns-section-soft" id="new">
        <div class="ns-section-heading">
            <div class="ns-eyebrow">JUST ADDED</div>
            <h2>What's New</h2>
            <p>Take a look at the latest additions to our collection.</p>
        </div>

        <div class="ns-new-grid">
            {% for product in newArrivals %}
                <div class="ns-new-item">
                    <div class="ns-new-photo">
                        {% if product.imageFilename %}
                            <img
                                src="{{ asset('uploads/products/' ~ product.imageFilename) }}"
                                alt="{{ product.name }}"
                                loading="lazy"
                            >
                        {% else %}
                            <span class="ns-product-placeholder">NS</span>
                        {% endif %}
                    </div>

                    <div class="ns-new-info">
                        <div class="ns-product-category">
                            {{ product.category }}
                        </div>
                        <h3>{{ product.name }}</h3>
                        <strong>₱{{ product.price|number_format(2) }}</strong>
                        {% if product.stock > 0 %}
                            <form method="post" action="{{ path('cart_add', {id: product.id}) }}" class="ns-cart-form">
                                <input type="hidden" name="_token" value="{{ csrf_token('cart_add_' ~ product.id) }}">
                                <button type="submit" class="ns-cart-button">🛒 Add to Cart</button>
                            </form>
                        {% else %}
                            <div class="ns-cart-form"><button type="button" class="ns-cart-button" disabled>Out of Stock</button></div>
                        {% endif %}
                    </div>
                </div>
            {% else %}
                <div class="ns-empty">
                    New arrivals will appear here soon.
                </div>
            {% endfor %}
        </div>
    </section>

    {# ABOUT #}
    
{# ABOUT US SECTION #}
<section class="ns-section ns-about" id="about">

    <div class="ns-about-art">
        <img
            src="{{ asset('images/about.png') }}"
            alt="NS COSMETIQ Skincare and Makeup Collection"
            class="ns-about-image"
        >
    </div>

    <div class="ns-about-copy">

        <div class="ns-eyebrow">
            OUR BEAUTY PHILOSOPHY
        </div>

        <h2>
            Beauty That Inspires Confidence.
        </h2>

        <p>
            At NS COSMETIQ, we believe beauty is about
            feeling comfortable, confident, and uniquely you.
            Our collection brings together skincare and
            makeup essentials for your everyday beauty routine.
        </p>

        <p>
            Discover the products you love, explore new
            favorites, and celebrate your personal style.
        </p>

        <a href="#products" class="ns-about-button">
            DISCOVER OUR PRODUCTS →
        </a>

    </div>

</section>

    {# FOOTER #}
    <footer class="ns-footer">
        <div class="ns-footer-grid">
            <div>
                <h3>NS COSMETIQ</h3>
                <p>
                    Discover Your Best Skin Ever.<br>
                    Your destination for skincare,
                    makeup, and everyday beauty.
                </p>
            </div>

            <div>
                <h4>EXPLORE</h4>
                <a href="#home">Home</a>
                <a href="#products">All Products</a>
                <a href="#categories">Categories</a>
                <a href="#new">What's New</a>
            </div>

            <div>
                <h4>NS COSMETIQ</h4>
                <a href="#offers">Special Offers</a>
                <a href="#about">About Us</a>
                {% if not app.user %}
                    <a href="{{ path('app_login') }}">Login</a>
                {% endif %}
            </div>
        </div>

        <div class="ns-footer-bottom">
            © {{ "now"|date("Y") }} NS COSMETIQ. All Rights Reserved.
        </div>
    </footer>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const searchInput = document.getElementById('nsProductSearch');
    const categoryFilter = document.getElementById('nsCategoryFilter');
    const cards = Array.from(
        document.querySelectorAll('#nsProductGrid .ns-product-card')
    );
    const noResults = document.getElementById('nsNoResults');

    function filterProducts() {
        const search = searchInput.value.trim().toLowerCase();
        const category = categoryFilter.value.toLowerCase();
        let visible = 0;

        cards.forEach(function (card) {
            const matchesName = card.dataset.name.includes(search);
            const matchesCategory =
                !category || card.dataset.category === category;

            const show = matchesName && matchesCategory;
            card.style.display = show ? '' : 'none';

            if (show) visible++;
        });

        noResults.style.display =
            cards.length > 0 && visible === 0 ? 'block' : 'none';
    }

    searchInput.addEventListener('input', filterProducts);
    categoryFilter.addEventListener('change', filterProducts);

    document.querySelectorAll('[data-category-link]').forEach(function (link) {
        link.addEventListener('click', function () {
            categoryFilter.value = link.dataset.categoryLink;
            searchInput.value = '';
            filterProducts();
        });
    });
});
</script>
{% endblock %}
