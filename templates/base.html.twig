
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1"
    >

    <title>
        {% block title %}NS COSMETIQ{% endblock %}
    </title>

    {# BOOTSTRAP #}
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    {# GOOGLE FONTS #}
    <link
        href="https://fonts.googleapis.com/css2?family=Raleway:wght@400;500;600;700;800&display=swap"
        rel="stylesheet"
    >

    {# EXISTING STYLES #}
    <link
        rel="stylesheet"
        href="{{ asset('css/ns_cosmetiq_admin.css') }}"
    >

    <link
        rel="stylesheet"
        href="{{ asset('css/ns_cosmetiq_login.css') }}"
    >

    <style>
        :root {
            --ns-cream: #FFF8F5;
            --ns-blush: #F9E3DC;
            --ns-terracotta: #C0603F;
            --ns-brown: #49332D;
            --ns-border: #E9C6B8;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            min-height: 100vh;
            margin: 0;
            background: var(--ns-cream);
            color: var(--ns-brown);
            font-family: 'Raleway', sans-serif;
        }

        /* ==========================
           ADMIN AND STAFF LAYOUT
           ========================== */

        .admin-layout {
            display: flex;
            flex-direction: row;
            width: 100%;
            min-height: 100vh;
        }

        .sidebar {
            width: 250px;
            min-width: 250px;
            min-height: 100vh;
            flex-shrink: 0;
            background: var(--ns-blush) !important;
            border-right: 1px solid var(--ns-border);
        }

        .sidebar .brand {
            padding: 24px 20px;
            font-size: 22px;
            font-weight: 800;
            color: var(--ns-brown);
            border-bottom: 1px solid var(--ns-border);
        }

        .sidebar .menu-label {
            color: #987A70;
            font-size: 12px;
            font-weight: 700;
            padding: 22px 20px 8px;
            text-transform: uppercase;
        }

        .sidebar .nav-link {
            display: block;
            color: var(--ns-brown) !important;
            padding: 12px 20px;
            margin: 3px 10px;
            border-radius: 9px;
            font-weight: 600;
            text-decoration: none;
        }

        .sidebar .nav-link:hover,
        .sidebar .nav-link.active {
            background: var(--ns-terracotta) !important;
            color: white !important;
        }

        .main-content {
            flex: 1;
            min-width: 0;
            background: var(--ns-cream);
        }

        .top-header {
            background: #FFFFFF;
            padding: 18px 25px;
            border-bottom: 1px solid #EEDBD4;
        }

        .top-header strong {
            color: var(--ns-terracotta);
            font-weight: 800;
        }

        .header-subtitle {
            margin-left: 12px;
            color: #94786F;
            font-size: 13px;
        }

        .header-user {
            color: var(--ns-brown);
            font-weight: 600;
        }

        .management-main {
            width: 100%;
            min-width: 0;
            padding: 24px;
        }

        /* ==========================
           CUSTOMER WEBSITE LAYOUT
           ========================== */

        .customer-layout {
            display: block;
            width: 100%;
            min-height: 100vh;
        }

        .customer-layout .main-content {
            display: block;
            width: 100%;
            max-width: 100%;
            min-width: 0;
            margin: 0;
            padding: 0;
        }

        .customer-main {
            display: block;
            width: 100%;
            max-width: 100%;
            min-width: 0;
            margin: 0;
            padding: 0;
        }

        .customer-main .ns-store {
            display: block;
            width: 100%;
            max-width: 100%;
            min-width: 0;
        }

        .customer-main .ns-store > section,
        .customer-main .ns-store > nav,
        .customer-main .ns-store > footer,
        .customer-main .ns-store > div {
            box-sizing: border-box;
            max-width: 100%;
        }

        /* ==========================
           RESPONSIVE DESIGN
           ========================== */

        @media (max-width: 991px) {
            .admin-layout {
                flex-direction: column;
            }

            .sidebar {
                width: 100%;
                min-width: 0;
                min-height: auto;
                border-right: none;
                border-bottom: 1px solid var(--ns-border);
            }

            .top-header {
                padding: 15px 18px;
                flex-wrap: wrap;
                gap: 10px;
            }

            .management-main {
                padding: 18px;
            }
        }

        @media (max-width: 576px) {
            .header-subtitle {
                display: block;
                margin-left: 0;
                margin-top: 5px;
            }

            .management-main {
                padding: 12px;
            }
        }
    </style>

    {% block stylesheets %}{% endblock %}
</head>

<body>

{# IDENTIFY CURRENT ROUTE #}
{% set current_route = app.request.attributes.get('_route')|default('') %}

{# DETERMINE WHETHER THIS IS A MANAGEMENT PAGE #}
{% set is_management =
    (is_granted('ROLE_ADMIN') or is_granted('ROLE_STAFF'))
    and (
        current_route starts with 'admin_'
        or current_route starts with 'staff_'
        or current_route starts with 'product_'
        or current_route in [
            'app_profile',
            'app_change_password'
        ]
    )
%}

{# SEPARATE CUSTOMER AND MANAGEMENT LAYOUTS #}
<div class="{{ is_management ? 'admin-layout' : 'customer-layout' }}">

    {# SIDEBAR ONLY FOR ADMIN AND STAFF PAGES #}
    {% if is_management %}
        {% include 'partials/sidebar.html.twig' %}
    {% endif %}

    <div class="main-content">

        {# MANAGEMENT HEADER #}
        {% if is_management %}
            <header class="top-header d-flex justify-content-between align-items-center">

                <div>
                    <strong>NS COSMETIQ</strong>

                    <span class="header-subtitle">
                        {% if is_granted('ROLE_ADMIN') %}
                            Admin Management System
                        {% else %}
                            Staff Management System
                        {% endif %}
                    </span>
                </div>

                <span class="header-user">
                    {{ app.user.fullName }}
                </span>

            </header>
        {% endif %}

        {# MAIN PAGE CONTENT #}
        <main class="{{ is_management ? 'management-main' : 'customer-main' }}">

            {# FLASH MESSAGES #}
            {% for type, messages in app.flashes %}
                {% for msg in messages %}
                    <div
                        class="alert alert-{{ type }} alert-dismissible fade show"
                        role="alert"
                    >
                        {{ msg }}

                        <button
                            type="button"
                            class="btn-close"
                            data-bs-dismiss="alert"
                            aria-label="Close"
                        ></button>
                    </div>
                {% endfor %}
            {% endfor %}

            {% block body %}{% endblock %}

        </main>

    </div>
</div>

{# BOOTSTRAP JAVASCRIPT #}
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

{% block javascripts %}{% endblock %}

</body>
</html>
