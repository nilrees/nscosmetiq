
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>{% block title %}NS Cosmetiq{% endblock %}</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <link href="https://fonts.googleapis.com/css2?family=Raleway:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="{{ asset('css/ns_cosmetiq_admin.css') }}">

    <link rel="stylesheet" href="{{ asset('css/ns_cosmetiq_login.css') }}">

<style>
    body {
        min-height: 100vh;
        margin: 0;
        background: #FFF8F5;
        color: #49332D;
        font-family: 'Raleway', sans-serif;
    }

    .admin-layout {
        min-height: 100vh;
        width: 100%;
    }

    .sidebar {
        width: 250px;
        min-height: 100vh;
        flex-shrink: 0;
        background: #F9E3DC !important;
        border-right: 1px solid #E9C6B8;
    }

    .sidebar .brand {
        padding: 24px 20px;
        font-size: 22px;
        font-weight: 800;
        color: #49332D;
        border-bottom: 1px solid #E9C6B8;
    }

    .sidebar .menu-label {
        color: #987A70;
        font-size: 12px;
        font-weight: 700;
        padding: 22px 20px 8px;
        text-transform: uppercase;
    }

    .sidebar .nav-link {
        display: block;
        color: #49332D !important;
        padding: 12px 20px;
        margin: 3px 10px;
        border-radius: 9px;
        font-weight: 600;
        text-decoration: none;
    }

    .sidebar .nav-link:hover,
    .sidebar .nav-link.active {
        background: #C0603F !important;
        color: white !important;
    }

    .main-content {
        flex: 1;
        min-width: 0;
        background: #FFF8F5;
    }

    .top-header {
        background: #FFFFFF;
        padding: 18px 25px;
        border-bottom: 1px solid #EEDBD4;
    }

    .top-header strong {
        color: #C0603F;
        font-weight: 800;
    }

    .header-subtitle {
        margin-left: 12px;
        color: #94786F;
        font-size: 13px;
    }

    .header-user {
        color: #49332D;
        font-weight: 600;
    }

    @media (max-width: 991px) {
        .sidebar {
            width: 100%;
            min-height: auto;
        }
    }
</style>

</head>

<body>

<div class="d-flex flex-column flex-lg-row admin-layout">

    {% if app.user %}
        {% include 'partials/sidebar.html.twig' %}
    {% endif %}

    <div class="main-content">

        {% if app.user %}
            <header class="top-header d-flex justify-content-between align-items-center">
                <div>
                    <strong>NS COSMETIQ</strong>
                    <span class="header-subtitle">Management System</span>
                </div>

                <span class="header-user">
                    {{ app.user.fullName }}
                </span>
            </header>
        {% endif %}

        
            <main class="{% if app.user %}container-fluid p-4{% else %}container-fluid p-0{% endif %}">


            {% for type, messages in app.flashes %}
                {% for msg in messages %}
                    <div class="alert alert-{{ type }} alert-dismissible fade show" role="alert">
                        {{ msg }}
                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="alert"
                                aria-label="Close"></button>
                    </div>
                {% endfor %}
            {% endfor %}

            {% block body %}{% endblock %}

        </main>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
