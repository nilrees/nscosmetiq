
{% extends 'base.html.twig' %}

{% block title %}Shop | NS COSMETIQ{% endblock %}

{% block body %}
<div class="container py-5">

    <h1 style="color:#49332D;">Shop NS COSMETIQ</h1>
    <p>Discover your favorite makeup and skincare essentials.</p>

    <form method="get" action="{{ path('shop_index') }}"
          class="row g-3 mb-4">

        <div class="col-md-5">
            <input type="text" name="search"
                   class="form-control"
                   placeholder="Search products..."
                   value="{{ search }}">
        </div>

        <div class="col-md-4">
            <input type="text" name="category"
                   class="form-control"
                   placeholder="Category"
                   value="{{ category }}">
        </div>

        <div class="col-md-3">
            <button class="btn btn-dark w-100" type="submit">
                Search
            </button>
        </div>
    </form>

    <div class="row g-4">
        {% for product in products %}
            <div class="col-md-4 col-lg-3">
                <div class="card h-100 shadow-sm">

                    {% if product.imageFilename %}
                        <img
                            src="{{ asset('uploads/products/' ~ product.imageFilename) }}"
                            alt="{{ product.name }}"
                            class="card-img-top"
                            style="height:230px;object-fit:cover;">
                    {% endif %}

                    <div class="card-body">
                        <h5>{{ product.name }}</h5>
                        <p>{{ product.category }}</p>

                        <h5 style="color:#C0603F;">
                            ₱{{ product.price|number_format(2) }}
                        </h5>

                        <p>Stock: {{ product.stock }}</p>

                        <form method="post"
                              action="{{ path('cart_add', {id: product.id}) }}">
                            <input type="hidden"
                                   name="_token"
                                   value="{{ csrf_token('cart_add_' ~ product.id) }}">

                            <button type="submit"
                                    class="btn w-100"
                                    style="background:#C0603F;color:white;">
                                Add to Cart
                            </button>
                        </form>
                    </div>

                </div>
            </div>
        {% else %}
            <div class="col-12">
                <p>No products available.</p>
            </div>
        {% endfor %}
    </div>

</div>
{% endblock %}
